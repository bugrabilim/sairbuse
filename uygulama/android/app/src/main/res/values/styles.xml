<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/zemin</item>
        <item name="colorPrimaryDark">@color/zemin</item>
        <item name="colorAccent">#EBCB52</item>
    </style>

    <!-- Uygulamanın teması: sitenin gece zemini, açık renkli durum ve gezinme çubuğu simgeleri -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/zemin</item>
        <item name="android:statusBarColor">@color/zemin</item>
        <item name="android:navigationBarColor">@color/zemin</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Açılış: koyu zeminde sarı damla (Android 12+ simgeyle, eskilerde drawable*/splash.png) -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/zemin</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
