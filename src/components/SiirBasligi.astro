---
import { ad, basliksiz, imza, siirYolu, type Siir } from '../lib/siirler';

interface Props {
  siir: Siir;
  seviye?: 'h1' | 'h2';
  bagli?: boolean;
}

const { siir, seviye = 'h1', bagli = false } = Astro.props;
const Baslik = seviye;
const im = imza(siir);
const href = bagli ? siirYolu(siir) : undefined;
---

<header class="siir-bas">
  {
    !basliksiz(siir) ? (
      <>
        <Baslik class="siir-ad">{href ? <a href={href}>{ad(siir)}</a> : ad(siir)}</Baslik>
        {im && <p class="imza">{im}</p>}
      </>
    ) : im ? (
      <Baslik class="imza-buyuk">{href ? <a href={href}>{im}</a> : im}</Baslik>
    ) : (
      <>
        <Baslik class="gorunmez">{href ? <a href={href}>{ad(siir)}</a> : ad(siir)}</Baslik>
        <p class="imza">tarihsiz</p>
      </>
    )
  }
</header>
