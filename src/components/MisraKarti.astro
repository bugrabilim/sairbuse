---
// Seçilen mısralardan Instagram/WhatsApp hikâyesi boyutunda (1080×1920) bir kart üretir.
// Kart tarayıcıda, sitenin kendi yazı tipleriyle ve şiirin fotoğrafıyla çizilir; hiçbir veri dışarı gönderilmez.
import { getImage } from 'astro:assets';
import { SITE } from '../data/site';
import { ad, anaDuygu, basliksiz, imza, type Siir } from '../lib/siirler';
import { gorsel, kunye, siirFotografi } from '../lib/foto';
import { duyguAdi } from '../data/duygular';
import { buyuk, dilBul, metin, siirYoluDil } from '../i18n';

interface Props {
  siir: Siir;
}

const { siir } = Astro.props;
const dil = dilBul(Astro.url);
const m = metin(dil);
const k = m.kart;
const yazilar = { olustur: k.olustur(0).replace('0', '{n}'), enCok: k.enCok(8).replace('8', '{n}'), dokun: k.dokun, hazirlaniyor: k.hazirlaniyor, hazirlanamadi: k.hazirlanamadi };
const d = anaDuygu(siir);
const foto = siirFotografi(siir);
const kartFotosu = foto ? await getImage({ src: gorsel(foto), width: 1080, format: 'jpeg' }) : undefined;
---

<div
  id="kart-verisi"
  hidden
  data-zemin={d.zeminGece}
  data-renk={d.gece}
  data-foto={kartFotosu?.src}
  data-kunye={foto ? `${kunye(foto, dil)} · Wikimedia Commons` : undefined}
  data-odak={foto?.odak}
  data-ton-ust={d.isik[0]}
  data-ton-alt={d.isik[1]}
  data-ton-golge={d.golge}
  data-duygu={buyuk(duyguAdi(d, dil), dil)}
  data-baslik={basliksiz(siir) ? '' : ad(siir)}
  data-imza={imza(siir, dil) || m.genel.tarihsiz}
  data-sair={SITE.sair}
  data-site={SITE.ad}
  data-adres={`duygularinpesinde.bumba.tr${siirYoluDil(siir.id, dil)}`}
  data-metin={JSON.stringify(yazilar)}
  data-dosya={`${siir.id}-misra.png`}
>
</div>

<dialog class="kart-pencere" id="kart-pencere" aria-labelledby="kart-baslik">
  <h2 id="kart-baslik" class="gorunmez">{k.baslik}</h2>
  <img id="kart-gorsel" alt={k.gorselAlt} width="1080" height="1920" />
  <div class="kart-araclar">
    <button class="dugme" type="button" id="kart-paylas" hidden>{k.paylas}</button>
    <a class="dugme" id="kart-indir" href="#" download>{k.indir}</a>
    <button class="dugme" type="button" id="kart-kapat">{k.kapat}</button>
  </div>
</dialog>

<script>
  const W = 1080;
  const H = 1920;
  const YAZI = '#f1eadf';
  const SOLUK = '#b7ae9f';
  const EN_COK = 8;

  const veri = document.getElementById('kart-verisi')?.dataset ?? {};
  const M: Record<string, string> = JSON.parse(veri.metin ?? '{}');
  const govde = document.getElementById('govde');
  const dugme = document.getElementById('kart-dugme');
  const olustur = document.getElementById('kart-olustur') as HTMLButtonElement | null;
  const durum = document.getElementById('durum');
  const pencere = document.getElementById('kart-pencere') as HTMLDialogElement | null;
  const gorsel = document.getElementById('kart-gorsel') as HTMLImageElement | null;
  const indir = document.getElementById('kart-indir') as HTMLAnchorElement | null;
  const paylasBtn = document.getElementById('kart-paylas') as HTMLButtonElement | null;
  const misralar = govde ? Array.from(govde.querySelectorAll<HTMLElement>('.misra')) : [];
  let dosya: File | null = null;
  let adres = '';

  function secililer() {
    return misralar.filter((m) => m.classList.contains('secili'));
  }

  function guncelle() {
    const n = secililer().length;
    if (olustur) {
      olustur.hidden = n === 0;
      olustur.textContent = M.olustur.replace('{n}', String(n));
    }
  }

  function sec(m: HTMLElement) {
    const secili = m.classList.contains('secili');
    if (!secili && secililer().length >= EN_COK) {
      if (durum) durum.textContent = M.enCok.replace('{n}', String(EN_COK));
      return;
    }
    m.classList.toggle('secili', !secili);
    m.setAttribute('aria-checked', String(!secili));
    guncelle();
  }

  function secimiAc() {
    govde?.classList.add('hepsi', 'secim');
    dugme?.setAttribute('aria-pressed', 'true');
    if (durum) durum.textContent = M.dokun;
    for (const m of misralar) {
      m.tabIndex = 0;
      m.setAttribute('role', 'checkbox');
      m.setAttribute('aria-checked', String(m.classList.contains('secili')));
    }
    guncelle();
  }

  function secimiKapat() {
    govde?.classList.remove('secim');
    dugme?.setAttribute('aria-pressed', 'false');
    if (olustur) olustur.hidden = true;
    if (durum) durum.textContent = '';
    for (const m of misralar) {
      m.classList.remove('secili');
      m.removeAttribute('tabindex');
      m.removeAttribute('role');
      m.removeAttribute('aria-checked');
    }
  }

  dugme?.addEventListener('click', () => (govde?.classList.contains('secim') ? secimiKapat() : secimiAc()));

  for (const m of misralar) {
    m.addEventListener('click', () => {
      if (govde?.classList.contains('secim')) sec(m);
    });
    m.addEventListener('keydown', (e) => {
      if (!govde?.classList.contains('secim')) return;
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        sec(m);
      }
    });
  }

  /** Genişliğe sığmayan mısrayı kelime kelime alt satıra böler */
  function sar(x: CanvasRenderingContext2D, satirlar: string[], genislik: number): string[] {
    const sonuc: string[] = [];
    for (const satir of satirlar) {
      if (x.measureText(satir).width <= genislik) {
        sonuc.push(satir);
        continue;
      }
      let simdiki = '';
      for (const k of satir.split(' ')) {
        const dene = simdiki ? `${simdiki} ${k}` : k;
        if (x.measureText(dene).width > genislik && simdiki) {
          sonuc.push(simdiki);
          simdiki = `  ${k}`;
        } else simdiki = dene;
      }
      if (simdiki) sonuc.push(simdiki);
    }
    return sonuc;
  }

  function fotoYukle(src: string): Promise<HTMLImageElement | null> {
    return new Promise((coz) => {
      const img = new Image();
      img.onload = () => coz(img);
      img.onerror = () => coz(null);
      img.src = src;
    });
  }

  /** Fotoğrafı tuvali kaplayacak biçimde kırpar, siyah beyaza çeker ve duygunun rengine boyar */
  function fotoCiz(x: CanvasRenderingContext2D, img: HTMLImageElement) {
    const [ox, oy] = (veri.odak ?? '50% 50%').split(' ').map((v) => parseFloat(v) / 100);
    const olcek = Math.max(W / img.width, H / img.height);
    const w = img.width * olcek;
    const h = img.height * olcek;
    x.fillStyle = '#808080';
    x.fillRect(0, 0, W, H);
    x.globalCompositeOperation = 'luminosity';
    x.drawImage(img, (W - w) * (ox || 0.5), (H - h) * (oy || 0.5), w, h);
    x.globalCompositeOperation = 'multiply';
    const ton = x.createLinearGradient(0, 0, 0, H);
    ton.addColorStop(0, veri.tonUst ?? '#efe6d6');
    ton.addColorStop(1, veri.tonAlt ?? '#c9b79a');
    x.fillStyle = ton;
    x.fillRect(0, 0, W, H);
    x.globalCompositeOperation = 'lighten';
    x.fillStyle = veri.tonGolge ?? '#15110c';
    x.fillRect(0, 0, W, H);
    x.globalCompositeOperation = 'source-over';
  }

  async function ciz(satirlar: string[]): Promise<Blob> {
    const tumMetin = satirlar.join(' ') + (veri.baslik ?? '') + (veri.sair ?? '') + (veri.site ?? '');
    const [img] = await Promise.all([
      veri.foto ? fotoYukle(veri.foto) : Promise.resolve(null),
      document.fonts.load('italic 300 80px "Fraunces"', tumMetin),
      document.fonts.load('300 80px "Fraunces"', tumMetin),
      document.fonts.load('600 30px "Inter"', `${veri.imza} ${veri.adres} ${veri.duygu} ${veri.site}`),
    ]);
    const tuval = document.createElement('canvas');
    tuval.width = W;
    tuval.height = H;
    const x = tuval.getContext('2d')!;
    const renk = veri.renk ?? YAZI;
    const zemin = veri.zemin ?? '#0d0c0b';

    x.fillStyle = zemin;
    x.fillRect(0, 0, W, H);
    if (img) fotoCiz(x, img);
    // Yazının okunması için alttan koyulaşan perde
    const perde = x.createLinearGradient(0, 0, 0, H);
    perde.addColorStop(0, 'rgba(0,0,0,0.45)');
    perde.addColorStop(0.16, 'rgba(0,0,0,0)');
    perde.addColorStop(img ? 0.3 : 0, `${zemin}00`);
    perde.addColorStop(img ? 0.62 : 0.4, `${zemin}e6`);
    perde.addColorStop(1, zemin);
    x.fillStyle = perde;
    x.fillRect(0, 0, W, H);

    const SOL = 96;
    x.textBaseline = 'alphabetic';
    x.fillStyle = YAZI;
    x.font = '600 26px "Inter"';
    if ('letterSpacing' in x) (x as CanvasRenderingContext2D & { letterSpacing: string }).letterSpacing = '6px';
    x.fillText((veri.site ?? '').toLocaleUpperCase('tr'), SOL, 150);
    x.textAlign = 'right';
    x.fillStyle = renk;
    x.fillText((veri.duygu ?? '').toLocaleUpperCase('tr'), W - SOL, 150);
    x.textAlign = 'left';
    if ('letterSpacing' in x) (x as CanvasRenderingContext2D & { letterSpacing: string }).letterSpacing = '0px';

    // Mısralar: sığana kadar küçülen yazı, alt yarıda
    const genislik = W - SOL * 2;
    let boyut = 92;
    let satir: string[] = [];
    for (; boyut >= 44; boyut -= 4) {
      x.font = `italic 300 ${boyut}px "Fraunces"`;
      satir = sar(x, satirlar, genislik);
      // önce küçülterek sığdırmayı dene; mısrayı bölmek son çare
      const bolunmedi = satir.length === satirlar.length || boyut <= 56;
      if (bolunmedi && satir.length * boyut * 1.18 <= 900) break;
    }
    const aralik = boyut * 1.18;
    const baslikYuk = veri.baslik ? 84 : 0;
    const blok = baslikYuk + satir.length * aralik;
    let y = H - 330 - blok + boyut;
    if (veri.baslik) {
      x.fillStyle = renk;
      x.font = '300 52px "Fraunces"';
      x.fillText(veri.baslik, SOL, y - boyut + 52);
      y += baslikYuk;
    }
    x.fillStyle = YAZI;
    x.font = `italic 300 ${boyut}px "Fraunces"`;
    for (const s of satir) {
      x.fillText(s, SOL, y);
      y += aralik;
    }

    x.fillStyle = SOLUK;
    x.font = '600 26px "Inter"';
    x.fillText(veri.imza ?? '', SOL, H - 230);
    x.fillStyle = YAZI;
    x.font = 'italic 300 56px "Fraunces"';
    x.fillText(veri.sair ?? '', SOL, H - 165);
    x.fillStyle = SOLUK;
    x.font = '600 24px "Inter"';
    x.fillText(veri.adres ?? '', SOL, H - 100);
    if (img && veri.kunye) {
      x.font = '500 18px "Inter"';
      x.fillText(veri.kunye, SOL, H - 56);
    }

    return new Promise((coz, red) => tuval.toBlob((b) => (b ? coz(b) : red(new Error('kart çizilemedi'))), 'image/png'));
  }

  olustur?.addEventListener('click', async () => {
    const satirlar = secililer().map((m) => m.textContent ?? '');
    if (!satirlar.length || !pencere || !gorsel || !indir) return;
    olustur.disabled = true;
    if (durum) durum.textContent = M.hazirlaniyor;
    try {
      const blob = await ciz(satirlar);
      if (adres) URL.revokeObjectURL(adres);
      adres = URL.createObjectURL(blob);
      dosya = new File([blob], veri.dosya ?? 'misra.png', { type: 'image/png' });
      gorsel.src = adres;
      indir.href = adres;
      indir.download = veri.dosya ?? 'misra.png';
      if (paylasBtn) paylasBtn.hidden = !(navigator.canShare && navigator.canShare({ files: [dosya] }));
      if (durum) durum.textContent = '';
      pencere.showModal();
    } catch {
      if (durum) durum.textContent = M.hazirlanamadi;
    } finally {
      olustur.disabled = false;
    }
  });

  paylasBtn?.addEventListener('click', async () => {
    if (!dosya) return;
    try {
      await navigator.share({ files: [dosya], text: `https://${veri.adres}` });
    } catch {
      /* vazgeçildi */
    }
  });

  document.getElementById('kart-kapat')?.addEventListener('click', () => pencere?.close());
  pencere?.addEventListener('click', (e) => {
    if (e.target === pencere) pencere.close();
  });
</script>

<style>
  .kart-pencere {
    border: 1px solid var(--cizgi);
    border-radius: 4px;
    background: var(--zemin);
    color: var(--yazi);
    padding: 1rem;
    max-width: min(92vw, 24rem);
    max-height: 94vh;
  }
  .kart-pencere::backdrop {
    background: rgba(0, 0, 0, 0.72);
  }
  .kart-pencere img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 72vh;
    object-fit: contain;
    border-radius: 6px;
  }
  .kart-araclar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 0.9rem;
  }
  .kart-araclar [hidden] {
    display: none;
  }
  /* Seçim sırasında düğme hep elin altında dursun */
  :global(#kart-olustur) {
    position: fixed;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    transform: translateX(-50%);
    z-index: 5;
    background: color-mix(in srgb, var(--vurgu) 22%, var(--zemin));
    box-shadow: 0 6px 24px var(--golge);
    font-size: 1.05rem;
    padding: 0.6rem 1.4rem;
  }
</style>
