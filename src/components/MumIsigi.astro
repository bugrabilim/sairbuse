---
// Mum ışığı: ekran kararır, şiir titreyen sıcak bir ışık halkasında okunur. Işık imleci ya da parmağı izler.
// Varsayılan kapalı; okur düğmeyle yakar. Ziyaret boyunca (sessionStorage) açık kalır, yeni ziyarette kapalı açılır.
// Hareketi azaltma açıksa ışık titremez ve yumuşak kayar yerine doğrudan gelir.
import { dilBul, metin } from '../i18n';
const m = metin(dilBul(Astro.url)).mum;
---

<button class="dugme mum-dugmesi" type="button" id="mum" aria-pressed="false">
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
    <path d="M12 3c1.6 2 2.6 3.4 2.6 5a2.6 2.6 0 0 1-5.2 0c0-1.6 1-3 2.6-5Z" />
    <path d="M9.5 13h5v8h-5z" />
  </svg>
  <span>{m.ac}</span>
</button>
<div class="mum-karanlik" id="mum-karanlik" hidden aria-hidden="true"></div>
<button class="mum-sondur" id="mum-sondur" type="button" hidden>{m.sondur}</button>

<script>
  const dugme = document.getElementById('mum');
  const karanlik = document.getElementById('mum-karanlik');
  const sondurDugmesi = document.getElementById('mum-sondur');
  const azHareket = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Dönüşüm (transform) taşıyan bir ebeveynin içinde "fixed" bozulmasın diye en dışa taşınır
  if (karanlik && sondurDugmesi) document.body.append(karanlik, sondurDugmesi);

  let acik = false;
  let kare = 0;
  const hedef = { x: innerWidth / 2, y: innerHeight * 0.45 };
  const isik = { ...hedef };

  // Işık önce şiir sütununun ortasında, ekranın üst üçte birinde yanar; okur kaydırdıkça satırlar ışığın içinden geçer
  function baslangic() {
    const govde = document.getElementById('govde')?.getBoundingClientRect();
    hedef.x = govde ? Math.min(innerWidth - 40, Math.max(40, govde.left + Math.min(govde.width, 420) / 2)) : innerWidth / 2;
    hedef.y = innerHeight * 0.4;
    isik.x = hedef.x;
    isik.y = hedef.y;
  }

  function ciz(t: number) {
    if (!karanlik) return;
    const yumusak = azHareket ? 1 : 0.12;
    isik.x += (hedef.x - isik.x) * yumusak;
    isik.y += (hedef.y - isik.y) * yumusak;
    const taban = Math.max(210, Math.min(Math.min(innerWidth, innerHeight) * 0.62, 400));
    const s = t / 1000;
    const titreme = azHareket ? 0 : 0.035 * Math.sin(s * 7.3) + 0.02 * Math.sin(s * 13.1 + 1.7) + 0.012 * Math.sin(s * 23.9);
    karanlik.style.setProperty('--x', `${isik.x}px`);
    karanlik.style.setProperty('--y', `${isik.y}px`);
    karanlik.style.setProperty('--r', `${taban * (1 + titreme)}px`);
    kare = requestAnimationFrame(ciz);
  }

  function izle(e: PointerEvent) {
    hedef.x = e.clientX;
    hedef.y = e.clientY;
  }

  function ayarla(yeni: boolean) {
    acik = yeni;
    dugme?.setAttribute('aria-pressed', String(acik));
    if (karanlik) karanlik.hidden = !acik;
    if (sondurDugmesi) sondurDugmesi.hidden = !acik;
    document.documentElement.classList.toggle('mumlu', acik);
    try {
      sessionStorage.setItem('mum', acik ? 'acik' : 'kapali');
    } catch {
      /* hatırlanmaz */
    }
    cancelAnimationFrame(kare);
    if (acik) {
      baslangic();
      window.addEventListener('pointermove', izle, { passive: true });
      window.addEventListener('pointerdown', izle, { passive: true });
      kare = requestAnimationFrame(ciz);
    } else {
      window.removeEventListener('pointermove', izle);
      window.removeEventListener('pointerdown', izle);
    }
  }

  dugme?.addEventListener('click', () => {
    ayarla(!acik);
    if (acik) window.bumbaOlay?.('mum-isigi');
  });
  sondurDugmesi?.addEventListener('click', () => {
    ayarla(false);
    dugme?.focus();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && acik) ayarla(false);
  });
  try {
    if (sessionStorage.getItem('mum') === 'acik') ayarla(true);
  } catch {
    /* yok */
  }
</script>

<style>
  .mum-dugmesi svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .mum-dugmesi[aria-pressed='true'] {
    color: var(--yazi);
  }
  .mum-dugmesi[aria-pressed='true'] svg path:first-child {
    fill: #f2b35e;
    stroke: #f2b35e;
  }
  .mum-karanlik {
    --x: 50vw;
    --y: 45vh;
    --r: 300px;
    position: fixed;
    inset: 0;
    z-index: 45;
    pointer-events: none;
    background: radial-gradient(
      circle at var(--x) var(--y),
      rgba(255, 178, 92, 0.13) 0,
      rgba(255, 150, 60, 0.07) calc(var(--r) * 0.42),
      rgba(10, 6, 3, 0.55) calc(var(--r) * 0.78),
      rgba(5, 3, 2, 0.95) var(--r)
    );
    animation: mum-yan 1.2s ease-out;
  }
  .mum-karanlik[hidden] {
    display: none;
  }
  @keyframes mum-yan {
    from {
      opacity: 0;
    }
  }
  .mum-sondur {
    position: fixed;
    z-index: 50;
    right: max(1rem, env(safe-area-inset-right));
    bottom: calc(1rem + env(safe-area-inset-bottom));
    appearance: none;
    border: 1px solid rgba(242, 179, 94, 0.45);
    border-radius: 999px;
    background: rgba(10, 6, 3, 0.85);
    color: #f2d2a4;
    font-family: var(--etiket);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.7rem 1.1rem;
    cursor: pointer;
  }
  .mum-sondur[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .mum-karanlik {
      animation: none;
    }
  }
</style>
