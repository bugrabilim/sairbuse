---
// Ortam sesi: sayfa açılınca kısık sesle (varsayılan %10) bu şiirin ya da duygunun sesi çalar; tarayıcı kuralları
// gereği ilk dokunuşta başlar. Düğme bir menü açar: kapalı, şiirin sesi, genel sesler (deniz, yağmur, vapur, gece,
// kafe, şehir, kuşlar, ev) ve ses düzeyi. Seçim ve düzey hatırlanır (localStorage). Sesler gerçek saha kayıtları
// (public/ortam/, künyeler src/data/ortam-sesleri.ts, çalınması scripts/ortam.ts).
import { dilBul, metin } from '../i18n';
import { ORTAMLAR, type Ortam } from '../data/ortam-sesleri';

interface Props {
  /** Bu sayfanın sesi: şiirde şiirin, duygu sayfasında duygunun sesi */
  varsayilan: Ortam;
  tur?: 'siir' | 'duygu';
}
const { varsayilan, tur = 'siir' } = Astro.props;
const m = metin(dilBul(Astro.url)).ortam;
const secenekler = [
  { ad: 'sessiz', etiket: m.kapat },
  { ad: 'varsayilan', etiket: tur === 'siir' ? m.siirin(m[varsayilan]) : m.duygunun(m[varsayilan]) },
  ...ORTAMLAR.map((o) => ({ ad: o, etiket: m[o] })),
];
// Betik metinleri düğmenin üstünden okur (işlevler JSON'a girmez, açık/kapalı kalıbı ayrıca gider)
const yazilar = {
  sessiz: m.sessiz,
  ...Object.fromEntries(ORTAMLAR.map((o) => [o, m[o]])),
  kapali: m.kapali,
  acik: m.acik('{ad}'),
};
---

<div class="ortam-kutusu">
  <button
    class="dugme ortam-dugmesi"
    type="button"
    id="ortam"
    aria-expanded="false"
    aria-controls="ortam-menusu"
    data-durum="sessiz"
    data-varsayilan={varsayilan}
    aria-label={m.kapali}
    data-metin={JSON.stringify(yazilar)}
  >
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
      <path d="M2 14c2.5 0 2.5-3 5-3s2.5 3 5 3 2.5-3 5-3 2.5 3 5 3"></path>
      <path d="M2 19c2.5 0 2.5-3 5-3s2.5 3 5 3 2.5-3 5-3 2.5 3 5 3" opacity=".5"></path>
    </svg>
    <span class="ortam-yazi">{m.sessiz}</span>
  </button>
  <div class="ortam-menusu" id="ortam-menusu" role="group" aria-label={m.baslik} hidden>
    {
      secenekler.map((s) => (
        <button type="button" class={s.ad === 'varsayilan' ? 'ortam-secenek bu-sayfa' : 'ortam-secenek'} data-ortam={s.ad} aria-pressed={s.ad === 'varsayilan' ? 'true' : 'false'}>
          <span class="isaret" aria-hidden="true" />
          {s.etiket}
        </button>
      ))
    }
    <label class="ortam-duzey">
      <span>{m.duzey}</span>
      <input type="range" min="0" max="1" step="0.05" value="0.1" id="ortam-duzey" />
    </label>
  </div>
</div>

<script>
  import { baslat, bitir, duzeyAyarla } from '../scripts/ortam';
  import { ORTAMLAR, type Ortam } from '../data/ortam-sesleri';

  const dugme = document.getElementById('ortam') as HTMLButtonElement | null;
  const menu = document.getElementById('ortam-menusu');
  const yazi = dugme?.querySelector('.ortam-yazi');
  const duzeyKutusu = document.getElementById('ortam-duzey') as HTMLInputElement | null;
  const secenekler = Array.from(menu?.querySelectorAll<HTMLButtonElement>('[data-ortam]') ?? []);
  const AD: Record<string, string> = JSON.parse(dugme?.dataset.metin ?? '{}');
  const varsayilan = (dugme?.dataset.varsayilan ?? 'deniz') as Ortam;
  /** sessiz: kapalı · varsayilan: her sayfada o şiirin/duygunun sesi · ya da her sayfada aynı genel ses */
  type Tercih = 'sessiz' | 'varsayilan' | Ortam;
  const gecerli = (t: string | null): t is Tercih => t === 'sessiz' || t === 'varsayilan' || (ORTAMLAR as readonly string[]).includes(t ?? '');
  const sesi = (t: Tercih): Ortam | null => (t === 'sessiz' ? null : t === 'varsayilan' ? varsayilan : t);

  function oku(anahtar: string): string | null {
    try {
      return localStorage.getItem(anahtar);
    } catch {
      return null;
    }
  }
  function yaz(anahtar: string, deger: string) {
    try {
      localStorage.setItem(anahtar, deger);
    } catch {
      /* hatırlanmaz */
    }
  }

  function goster(t: Tercih) {
    if (!dugme || !yazi) return;
    const s = sesi(t);
    dugme.dataset.durum = s ?? 'sessiz';
    dugme.setAttribute('aria-label', s ? AD.acik.replace('{ad}', AD[s]) : AD.kapali);
    yazi.textContent = s ? AD[s] : AD.sessiz;
    secenekler.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.ortam === t)));
  }

  function uygula(t: Tercih) {
    goster(t);
    yaz('ortam-tercih', t);
    const s = sesi(t);
    if (s) {
      baslat(s);
      window.bumbaOlay?.('ortam-sesi', { ses: s });
    } else bitir();
  }

  function menuAc(acik: boolean) {
    if (!menu || !dugme) return;
    menu.hidden = !acik;
    dugme.setAttribute('aria-expanded', String(acik));
    if (acik) menu.querySelector<HTMLElement>('[aria-pressed="true"]')?.focus();
  }

  dugme?.addEventListener('click', (e) => {
    e.stopPropagation();
    menuAc(menu?.hidden === true);
  });
  menu?.addEventListener('click', (e) => e.stopPropagation());
  document.addEventListener('click', () => {
    if (menu && !menu.hidden) menuAc(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) {
      menuAc(false);
      dugme?.focus();
    }
  });
  secenekler.forEach((x) => x.addEventListener('click', () => uygula((x.dataset.ortam ?? 'sessiz') as Tercih)));

  // Ses düzeyi: varsayılan %10, değiştirilirse hatırlanır
  const kayitliDuzey = Number(oku('ortam-duzey') ?? '0.1');
  const duzey = Number.isFinite(kayitliDuzey) ? kayitliDuzey : 0.1;
  if (duzeyKutusu) duzeyKutusu.value = String(duzey);
  duzeyAyarla(duzey);
  duzeyKutusu?.addEventListener('input', () => {
    const v = Number(duzeyKutusu.value);
    duzeyAyarla(v);
    yaz('ortam-duzey', String(v));
  });

  // Varsayılan açık: okur kapatmadıysa ses ilk dokunuşta (tarayıcı kuralı) kendiliğinden başlar
  const kayitli = oku('ortam-tercih');
  const tercih: Tercih = gecerli(kayitli) ? kayitli : 'varsayilan';
  goster(tercih);
  const ilk = sesi(tercih);
  if (ilk) {
    const olaylar = ['pointerup', 'touchend', 'click', 'keydown'] as const;
    const basla = () => {
      olaylar.forEach((o) => window.removeEventListener(o, basla, true));
      if (dugme?.dataset.durum === ilk) baslat(ilk);
    };
    olaylar.forEach((o) => window.addEventListener(o, basla, true));
  }
</script>

<style>
  .ortam-kutusu {
    position: relative;
  }
  .ortam-dugmesi svg {
    flex: none;
  }
  .ortam-dugmesi:not([data-durum='sessiz']) {
    color: var(--yazi);
  }
  .ortam-dugmesi:not([data-durum='sessiz']) svg {
    animation: dalga 3s ease-in-out infinite;
  }
  @keyframes dalga {
    50% {
      transform: translateX(2px);
    }
  }
  .ortam-menusu {
    position: absolute;
    z-index: 15;
    top: calc(100% + 0.25rem);
    left: 0;
    min-width: 12.5rem;
    display: grid;
    padding: 0.4rem;
    background: var(--zemin-2);
    border: 1px solid var(--cizgi);
    border-radius: 6px;
    box-shadow: 0 12px 30px var(--golge);
  }
  /* Fotoğraflı başlığın içindeyken (duygu sayfası) yukarı açılır; başlık taşanı kesiyor */
  :global(.sahne) .ortam-menusu {
    top: auto;
    bottom: calc(100% + 0.25rem);
  }
  @media (max-width: 40rem) {
    .ortam-menusu,
    :global(.sahne) .ortam-menusu {
      position: fixed;
      top: auto;
      left: 0.75rem;
      right: 0.75rem;
      bottom: calc(0.75rem + env(safe-area-inset-bottom));
      z-index: 60;
      min-width: 0;
    }
  }
  .ortam-menusu[hidden] {
    display: none;
  }
  .ortam-secenek {
    appearance: none;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.7rem;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--yazi);
    font-family: var(--etiket);
    font-size: 0.85rem;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
  }
  .ortam-secenek:hover,
  .ortam-secenek:focus-visible {
    background: color-mix(in srgb, var(--vurgu) 14%, transparent);
  }
  .isaret {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    border: 1px solid var(--soluk);
    flex: none;
  }
  .ortam-secenek[aria-pressed='true'] .isaret {
    background: var(--vurgu);
    border-color: var(--vurgu);
  }
  .ortam-duzey {
    display: grid;
    gap: 0.35rem;
    padding: 0.6rem 0.7rem 0.4rem;
    margin-top: 0.25rem;
    border-top: 1px solid var(--cizgi);
    font-family: var(--etiket);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--soluk);
  }
  .ortam-duzey input {
    width: 100%;
    accent-color: var(--vurgu);
  }
</style>
