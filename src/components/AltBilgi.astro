---
// Sitenin alt bilgisi: masaüstünde tek satır. Solda telif (ilk şiirin yılından itibaren, bitiş yılı yok),
// ortada e-posta listesi, sağda Bumba imzası (sahibinin kararı, standarda projeye özel istisna). Telifin altında
// gizlilik bağlantısı ve çerez tercihleri (Standartlar §9, §14). Güncelleme tarihi Hakkında'da, JSON-LD ve llms.txt'de.
import { SITE } from '../data/site';
import ListeFormu from './ListeFormu.astro';
import { tumSiirler } from '../lib/siirler';
import { dilBul, metin, sayfaYolu } from '../i18n';
import { MAGAZA_GORUNUR, SITE_KOK, UYGULAMA, appStoreAdresi } from '../data/uygulama';

const dil = dilBul(Astro.url);
const m = metin(dil).alt;
const mu = metin(dil).uygulama;
const tum = await tumSiirler();
const ilkYil = tum.find((s) => s.data.tarih)?.data.tarih?.slice(0, 4) ?? String(new Date().getFullYear());
---

<footer class="alt">
  <div class="alt-izgara">
    <div class="alt-sol">
      <p>{m.telif(ilkYil, SITE.sair)}</p>
      <p class="alt-baglar">
        <a href={UYGULAMA ? `${SITE_KOK}${sayfaYolu('gizlilik', dil)}` : sayfaYolu('gizlilik', dil)}>{m.gizlilik}</a>
        {!UYGULAMA && <button class="cerez-ac" type="button">{m.cerez}</button>}
      </p>
    </div>
    <div class="alt-orta">
      {/* Uygulamada liste formu yok: katılmak için site Safari'de açılır (rıza akışı tek yerde kalır) */}
      {UYGULAMA ? <a class="liste-site" href={`${SITE_KOK}${sayfaYolu('ana', dil)}#liste`}>{mu.listeyeKatil}</a> : <ListeFormu />}
    </div>
    <div class="alt-sag">
      {/* App Store bağlantısı uygulama mağazada yayına girince görünür (src/data/uygulama.ts → APP_STORE) */}
      {MAGAZA_GORUNUR && <a class="magaza" href={appStoreAdresi(dil)} rel="noopener">{m.uygulama}</a>}
      {/* Bumba Group imzası (https://bumbagroup.com/marka). Sitenin temasını izler: gece temasında koyu rozet */}
      <a class="bumba-imza" href="https://bumbagroup.com/life" rel="noopener" title={m.rozetBaslik}>
        <img class="rozet-acik" src="https://bumbagroup.com/rozet/life.svg" width="164" height="28" alt={m.rozetAlt} loading="lazy" />
        <img class="rozet-koyu" src="https://bumbagroup.com/rozet/life-koyu.svg" width="164" height="28" alt={m.rozetAlt} loading="lazy" />
      </a>
    </div>
  </div>
</footer>

<style>
  .alt {
    margin-top: 3rem;
    padding: 1.4rem var(--kenar) max(1.4rem, env(safe-area-inset-bottom));
    border-top: 1px solid var(--cizgi);
    color: var(--soluk);
    font-size: 0.85rem;
  }
  /* Tek satır: solda telif, ortada e-posta listesi, sağda imza; yan sütunlar eşit, liste ortada durur */
  .alt-izgara {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 1rem 2rem;
    align-items: center;
    max-width: 80rem;
    margin: 0 auto;
  }
  .alt-sol p {
    margin: 0;
    text-wrap: balance;
  }
  .alt-baglar {
    margin-top: 0.35rem !important;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
  }
  .alt-baglar a {
    color: var(--soluk);
  }
  .cerez-ac {
    font: inherit;
    color: var(--soluk);
    background: none;
    border: 0;
    padding: 0;
    text-decoration: underline;
    cursor: pointer;
  }
  .alt-baglar a:hover,
  .cerez-ac:hover {
    color: var(--yazi);
  }
  .alt-sag {
    justify-self: end;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem 1.25rem;
  }
  .magaza {
    text-decoration: none;
    white-space: nowrap;
  }
  .alt a {
    color: var(--soluk);
  }
  .alt a:hover {
    color: var(--yazi);
  }
  .liste-site {
    font-family: var(--serif-baslik);
    font-size: 1.1rem;
    color: var(--yazi) !important;
    text-decoration: none;
  }
  .bumba-imza {
    display: inline-flex;
    line-height: 0;
    opacity: 0.85;
  }
  .bumba-imza:hover {
    opacity: 1;
  }
  :global([data-theme='gece']) .rozet-acik,
  :global([data-theme='gunduz']) .rozet-koyu {
    display: none;
  }
  /* Orta genişlikte iki satır: üstte liste, altta telif ve imza */
  @media (max-width: 72rem) {
    .alt-izgara {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .alt-orta {
      grid-column: 1 / -1;
      order: -1;
    }
  }
  /* Telefonda alt alta: önce liste, sonra telif, en sonda imza */
  @media (max-width: 40rem) {
    .alt-izgara {
      grid-template-columns: 1fr;
    }
    .alt-sag {
      justify-self: start;
      justify-content: flex-start;
    }
  }
</style>
