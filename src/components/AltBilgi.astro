---
// Sitenin alt bilgisi. Telif yılı ilk şiirin yılından başlar.
import { SITE } from '../data/site';
import ListeFormu from './ListeFormu.astro';
import { DUYGULAR, duyguAdi } from '../data/duygular';
import { siirYolu, tumSiirler, uzunTarih } from '../lib/siirler';
import { dilBul, duyguYolu, kucuk, metin, sayfaYolu } from '../i18n';

interface Props {
  menu: { href: string; ad: string }[];
}

const { menu } = Astro.props;
const dil = dilBul(Astro.url);
const m = metin(dil).alt;
const tum = await tumSiirler();
const ilk = tum.find((s) => s.data.tarih);
const ilkYil = ilk?.data.tarih?.slice(0, 4);
const buYil = String(new Date().getFullYear());
const yillar = ilkYil && ilkYil !== buYil ? `${ilkYil}–${buYil}` : buYil;
---

<footer class="alt">
  <ListeFormu />
  <div class="alt-ust">
    <div class="alt-kimlik">
      <a class="logo" href={sayfaYolu('ana', dil)}>{SITE.ad}</a>
      <p>{m.ozet(tum.length)}</p>
      {
        ilk && (
          <p>
            {m.ilkSiir} <a href={siirYolu(ilk, dil)}>{uzunTarih(ilk.data.tarih!, dil)}</a>
          </p>
        )
      }
    </div>
    <nav class="alt-menu" aria-label={m.altMenu}>
      {menu.map((m) => <a href={m.href}>{m.ad}</a>)}
    </nav>
    <ul class="alt-duygular" aria-label={metin(dil).ust.duygular}>
      {
        DUYGULAR.map((d) => (
          <li>
            <a href={duyguYolu(d.slug, dil)} style={`--nokta:${d.nokta}`}>
              <span class="nokta" aria-hidden="true" />
              {kucuk(duyguAdi(d, dil), dil)}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="alt-cizgi">
    <p>{m.telif(yillar, SITE.sair)} {m.fotoNot} <a href={`${sayfaYolu('hakkinda', dil)}#fotograflar`}>{m.kunyeler}</a>.</p>
    <div class="alt-sag">
      <a href={`${sayfaYolu('hakkinda', dil)}#haklar`}>{m.haklar}</a>
      <a href={sayfaYolu('gizlilik', dil)}>{m.gizlilik}</a>
      {/* Bumba Group imzası (https://bumbagroup.com/marka). Sitenin temasını izler: gece temasında koyu rozet */}
      <a class="bumba-imza" href="https://bumbagroup.com/life" rel="noopener" title={m.rozetBaslik}>
        <img class="rozet-acik" src="https://bumbagroup.com/rozet/life.svg" width="164" height="28" alt={m.rozetAlt} loading="lazy" />
        <img class="rozet-koyu" src="https://bumbagroup.com/rozet/life-koyu.svg" width="164" height="28" alt={m.rozetAlt} loading="lazy" />
      </a>
    </div>
  </div>
</footer>

<style>
  .alt {
    margin-top: 3rem;
    padding: 2.5rem var(--kenar) 2rem;
    border-top: 1px solid var(--cizgi);
    color: var(--soluk);
    font-size: 0.95rem;
  }
  .alt p {
    margin: 0;
  }
  .alt-ust {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 1.75rem 2rem;
    max-width: 64rem;
    margin: 0 auto;
  }
  .alt-kimlik {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }
  .alt-kimlik .logo {
    color: var(--yazi);
    margin-bottom: 0.5rem;
  }
  .alt-menu,
  .alt-duygular {
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }
  .alt-duygular {
    list-style: none;
    padding: 0;
    margin: 0;
    grid-template-columns: repeat(2, max-content);
    column-gap: 1.25rem;
  }
  .alt a {
    color: var(--soluk);
    text-decoration: none;
  }
  .alt a:hover {
    color: var(--yazi);
  }
  .alt-duygular a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .bumba-imza {
    display: inline-flex;
    opacity: 0.85;
  }
  .bumba-imza:hover {
    opacity: 1;
  }
  :global([data-theme='gece']) .rozet-acik,
  :global([data-theme='gunduz']) .rozet-koyu {
    display: none;
  }
  .alt-sag {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .alt-cizgi a {
    text-decoration: underline;
    text-decoration-color: var(--cizgi);
  }
  .alt-cizgi {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    max-width: 64rem;
    margin: 2rem auto 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--cizgi);
  }
  @media (max-width: 44rem) {
    .alt-ust {
      grid-template-columns: 1fr 1fr;
    }
    .alt-kimlik {
      grid-column: 1 / -1;
    }
  }
</style>
