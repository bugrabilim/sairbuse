---
// Sitenin alt bilgisi. Telif yılı ilk şiirin yılından başlar.
import { SITE } from '../data/site';
import ListeFormu from './ListeFormu.astro';
import { tumSiirler } from '../lib/siirler';
import { dilBul, metin, sayfaYolu, uzunTarihDil } from '../i18n';

const dil = dilBul(Astro.url);
const m = metin(dil).alt;
const tum = await tumSiirler();
const ilk = tum.find((s) => s.data.tarih);
const ilkYil = ilk?.data.tarih?.slice(0, 4);
const buYil = String(new Date().getFullYear());
const yillar = ilkYil && ilkYil !== buYil ? `${ilkYil}–${buYil}` : buYil;
// Sitenin en son derlendiği gün (her yayında yenilenir)
const bugun = new Date().toISOString().slice(0, 10);
---

<footer class="alt">
  <div class="alt-izgara">
    <div class="alt-sol">
      <p>{m.telif(yillar, SITE.sair)}</p>
      <p>
        {m.fotoNot} <a href={`${sayfaYolu('hakkinda', dil)}#fotograflar`}>{m.kunyeler}</a>.
      </p>
      <p>
        {m.guncelleme}: <time datetime={bugun}>{uzunTarihDil(bugun, dil)}</time>.
      </p>
    </div>
    <div class="alt-orta">
      <ListeFormu />
    </div>
    <div class="alt-sag">
      {/* Bumba Group imzası (https://bumbagroup.com/marka). Sitenin temasını izler: gece temasında koyu rozet */}
      <a class="bumba-imza" href="https://bumbagroup.com/life" rel="noopener" title={m.rozetBaslik}>
        <img class="rozet-acik" src="https://bumbagroup.com/rozet/life.svg" width="164" height="28" alt={m.rozetAlt} loading="lazy" />
        <img class="rozet-koyu" src="https://bumbagroup.com/rozet/life-koyu.svg" width="164" height="28" alt={m.rozetAlt} loading="lazy" />
      </a>
    </div>
  </div>
</footer>

<style>
  .alt {
    margin-top: 3rem;
    padding: 2.5rem var(--kenar) 2.5rem;
    border-top: 1px solid var(--cizgi);
    color: var(--soluk);
    font-size: 0.9rem;
  }
  /* Tek satır: solda telif, ortada e-posta listesi, sağda imza */
  .alt-izgara {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 2rem 3rem;
    align-items: center;
    max-width: 72rem;
    margin: 0 auto;
  }
  .alt-sol p {
    margin: 0 0 0.3rem;
  }
  .alt-sag {
    justify-self: end;
  }
  .alt a {
    color: var(--soluk);
  }
  .alt a:hover {
    color: var(--yazi);
  }
  .alt-sol a {
    text-decoration: underline;
    text-decoration-color: var(--cizgi);
  }
  .bumba-imza {
    display: inline-flex;
    line-height: 0;
    opacity: 0.85;
  }
  .bumba-imza:hover {
    opacity: 1;
  }
  :global([data-theme='gece']) .rozet-acik,
  :global([data-theme='gunduz']) .rozet-koyu {
    display: none;
  }
  /* Telefonda alt alta: önce liste, sonra telif, en sonda imza */
  @media (max-width: 52rem) {
    .alt-izgara {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .alt-orta {
      order: -1;
    }
    .alt-sag {
      justify-self: start;
    }
  }
</style>
