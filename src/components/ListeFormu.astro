---
// Bumba ortak e-posta listesine katılma formu (Bumba Genel Standartlar madde 1 ve 6; 5.43).
// Form yalnız katılım talebidir: pencere, onay kutusu ve aydınlatma bağlantısı yok, sayfa sunucuyu beklemez.
// Açık rızayı, onay e-postasını ve bütün bilgilendirme metinlerini ortak servis ilk e-postada verir.
// Akış: adres geçerliyse istek gider, cevap beklenmeden alanın yerinde "Katılım talebiniz alındı" görünür
// (10 saniye ya da tıklanana kadar). Hata dönerse yazı kalkar, adres geri yazılır, hata söylenir.
// JavaScript yoksa form doğrudan gider ve `donus` adresine #liste-tamam ile döner (:target ile aynı yazı).
import { SITE } from '../data/site';
import { dilBul, metin, sayfaYolu } from '../i18n';

const dil = dilBul(Astro.url);
const m = metin(dil).liste;
const donus = new URL(Astro.url.pathname, Astro.site).href;
const gizlilik = new URL(sayfaYolu('gizlilik', dil), Astro.site).href;
const yazilar = { gecersiz: m.gecersiz, gonderilemedi: m.gonderilemedi };
---

<section class="liste-kutusu" id="liste" aria-labelledby="liste-baslik">
  <h2 id="liste-baslik" class="liste-baslik">{m.baslik}</h2>
  <form class="liste-form" id="liste-form" action="https://bumbagroup.com/api/liste/katil" method="post" data-metin={JSON.stringify(yazilar)}>
    <input type="hidden" name="site" value={SITE.liste} />
    <input type="hidden" name="dil" value={dil} />
    <input type="hidden" name="gizlilik" value={gizlilik} />
    <input type="hidden" name="donus" value={donus} />
    <input type="hidden" name="kaynak" value={donus} />
    <input class="bot-tuzagi" type="text" name="web_sitesi" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <label class="gorunmez" for="liste-eposta">{m.etiket}</label>
    <span class="liste-alan">
      <input
        id="liste-eposta"
        type="email"
        name="eposta"
        required
        maxlength="254"
        autocomplete="email"
        inputmode="email"
        pattern="[^@\s]+@[^@\s]+\.[^@\s]{2,}"
        placeholder={m.yerTutucu}
      />
      <span class="liste-tamam" id="liste-tamam" role="status" hidden>{m.tamam}</span>
    </span>
    <button class="dugme" type="submit">{m.katil}</button>
    <span class="liste-hata" id="liste-hata" role="alert"></span>
  </form>
</section>

<script>
  const form = document.getElementById('liste-form') as HTMLFormElement | null;
  const alan = document.getElementById('liste-eposta') as HTMLInputElement | null;
  const tamam = document.getElementById('liste-tamam');
  const hata = document.getElementById('liste-hata');
  const M = JSON.parse(form?.dataset.metin ?? '{}') as { gecersiz: string; gonderilemedi: string };
  // Servisle aynı kalıp (madde 6), en çok 254 karakter
  const KALIP = /^[^\s@<>"',;]+@[^\s@<>"',;]+\.[^\s@<>"',;]{2,}$/;
  let sure: number | undefined;

  function tamamGizle(odakla = false) {
    clearTimeout(sure);
    if (tamam) tamam.hidden = true;
    form?.classList.remove('gonderildi');
    if (odakla) alan?.focus();
  }
  function tamamGoster() {
    if (!tamam) return;
    tamam.hidden = false;
    form?.classList.add('gonderildi');
    clearTimeout(sure);
    sure = window.setTimeout(() => tamamGizle(), 10000);
  }
  function hataYaz(s: string) {
    if (hata) hata.textContent = s;
  }

  if (form && alan) {
    form.noValidate = true;
    // Betiksiz gönderimden dönüş
    if (location.hash === '#liste-tamam') tamamGoster();
    else if (location.hash === '#liste-hata') hataYaz(M.gonderilemedi);

    tamam?.addEventListener('click', () => tamamGizle(true));
    alan.addEventListener('input', () => hataYaz(''));

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const adres = alan.value.trim();
      if (adres.length > 254 || !KALIP.test(adres)) {
        hataYaz(M.gecersiz);
        alan.focus();
        return;
      }
      alan.value = adres;
      hataYaz('');
      const veri = new FormData(form);
      veri.delete('donus');
      // Cevap beklenmeden: alan boşalır, yerinde "Katılım talebiniz alındı"
      alan.value = '';
      tamamGoster();
      fetch(form.action, { method: 'POST', body: veri, headers: { Accept: 'application/json' }, keepalive: true })
        .then((y) => y.json().catch(() => ({ durum: 'hata' })))
        .catch(() => ({ durum: 'hata' }))
        .then((sonuc: { durum?: string }) => {
          if (sonuc.durum === 'tamam') {
            window.bumbaOlay?.('liste-katil');
            return;
          }
          tamamGizle();
          alan.value = adres;
          hataYaz(sonuc.durum === 'gecersiz-eposta' ? M.gecersiz : M.gonderilemedi);
        });
    });
  }
</script>

<style>
  /* Çerçevesiz: başlık ve form yan yana, dar ekranda başlık üstte */
  .liste-kutusu {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem 1.25rem;
  }
  .liste-baslik {
    margin: 0;
    font-size: 1.15rem;
    color: var(--yazi);
  }
  /* Tek satır: alan ve düğme her genişlikte yan yana; dar ekranda alan daralır, düğme yazısı kısalmaz */
  .liste-form {
    position: relative;
    flex: 0 1 25rem;
    width: 25rem;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.75rem;
  }
  .liste-alan {
    position: relative;
    flex: 1 1 0;
    min-width: 6rem;
    display: flex;
  }
  .liste-alan input {
    flex: 1;
    width: 100%;
    min-width: 0;
    font: inherit;
    color: var(--yazi);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--cizgi);
    padding: 0.45rem 0.1rem;
    border-radius: 0;
  }
  .liste-alan input:focus-visible {
    outline: 2px solid var(--vurgu);
    outline-offset: 2px;
  }
  .liste-alan input::placeholder {
    color: var(--soluk);
  }
  .liste-form .dugme {
    flex: none;
    white-space: nowrap;
  }
  /* "Katılım talebiniz alındı": alanın yerinde, aynı kutuda; koyu temada açık yeşil, açık temada koyu yeşil */
  .liste-tamam {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding: 0 0.1rem;
    background: var(--zemin);
    border-bottom: 1px solid currentColor;
    color: #86efac;
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    cursor: pointer;
  }
  .liste-tamam[hidden] {
    display: none;
  }
  :global([data-theme='gunduz']) .liste-tamam {
    color: #166534;
  }
  /* Betiksiz dönüş: #liste-tamam adresi hedef olunca görünür */
  .liste-tamam:target {
    display: flex;
  }
  .liste-hata {
    flex-basis: 100%;
    font-size: 0.85rem;
    color: var(--yazi);
  }
  .liste-hata:empty {
    display: none;
  }
  .liste-hata:not(:empty) {
    margin-top: 0.4rem;
  }
  .liste-hata:not(:empty)::before {
    content: '! ';
    color: var(--vurgu);
    font-weight: 600;
  }
  @media (max-width: 40rem) {
    .liste-form {
      flex-basis: 100%;
      width: auto;
    }
  }
  /* Çok dar ekranda alan kısa kalır: yazı alanla düğmenin satırını kaplar (düğme 10 saniye görünmez) */
  @media (max-width: 30rem) {
    .liste-alan {
      position: static;
    }
    .liste-tamam {
      z-index: 1;
    }
  }
  .bot-tuzagi {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
</style>
