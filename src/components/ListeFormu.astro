---
// Bumba ortak e-posta listesine katılma formu (Bumba Genel Standartlar §6).
// Çift onayı, rıza kaydını, onay/çıkış e-postalarını ve bot korumasını ortak servis yapar; burada yalnız form var.
// Alt bilgide yalnız adres ve "Katıl" durur; Katıl'a basınca açılan pencerede kısa aydınlatma özeti, önceden
// işaretsiz rıza kutusu ve asıl gönderme düğmesi var. JavaScript yoksa pencerenin içeriği formun altında açık durur;
// form servise gider ve sonuç #liste-tamam / #liste-hata ile bu sayfaya döner.
import { SITE } from '../data/site';
import { dilBul, metin } from '../i18n';

const dil = dilBul(Astro.url);
const m = metin(dil).liste;
const donus = new URL(Astro.url.pathname, Astro.site).href;
const aydinlatma = dil === 'en' ? 'https://bumbagroup.com/liste/aydinlatma?dil=en' : 'https://bumbagroup.com/liste/aydinlatma';
const [rizaOnce, rizaSonra] = m.riza.split('{aydinlatma}');
const yazilar = { tamam: m.tamam, gonderiliyor: m.gonderiliyor, katil: m.katil, hatalar: m.hatalar };
---

<section class="liste-kutusu" id="liste" aria-labelledby="liste-baslik">
  <h2 id="liste-baslik" class="liste-baslik">{m.baslik}</h2>
  <form class="liste-formu" action="https://bumbagroup.com/api/liste/katil" method="post" data-metin={JSON.stringify(yazilar)}>
    <input type="hidden" name="site" value={SITE.liste} />
    <input type="hidden" name="dil" value={dil} />
    <input type="hidden" name="donus" value={donus} />
    <input type="hidden" name="kaynak" value={donus} />
    <div class="liste-satir">
      <label class="gorunmez" for="liste-eposta">{m.eposta}</label>
      <input id="liste-eposta" type="email" name="eposta" required autocomplete="email" placeholder={m.eposta} />
      <button class="dugme liste-ac" type="button" aria-haspopup="dialog">{m.katil}</button>
    </div>
    <dialog class="liste-onay" aria-labelledby="liste-onay-baslik">
      <h3 id="liste-onay-baslik">{m.onayBaslik}</h3>
      <p>{m.onayMetni}</p>
      <label class="liste-riza">
        <input type="checkbox" name="riza" value="on" required />
        <span>{rizaOnce}<a href={aydinlatma} rel="noopener">{m.aydinlatma}</a>{rizaSonra}</span>
      </label>
      <div class="liste-onay-dugmeler">
        <button class="dugme liste-vazgec" type="button">{m.vazgec}</button>
        <button class="dugme vurgulu" type="submit">{m.katil}</button>
      </div>
    </dialog>
    <input class="bot-tuzagi" type="text" name="web_sitesi" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <p class="liste-durum" role="status" aria-live="polite"></p>
  </form>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('.liste-formu');
  const durum = form?.querySelector<HTMLElement>('.liste-durum');
  const eposta = form?.querySelector<HTMLInputElement>('input[type="email"]');
  const ac = form?.querySelector<HTMLButtonElement>('.liste-ac');
  const onay = form?.querySelector<HTMLDialogElement>('.liste-onay');
  const M = JSON.parse(form?.dataset.metin ?? '{}');

  function goster(metin: string, iyi: boolean) {
    if (!durum) return;
    durum.textContent = metin;
    durum.dataset.durum = iyi ? 'tamam' : 'hata';
  }

  // JS'siz gönderimden dönüşte sonucu göster
  if (location.hash === '#liste-tamam') goster(M.tamam, true);
  else if (location.hash === '#liste-hata') goster(M.hatalar.hata, false);

  // Katıl: adres geçerliyse onay penceresi açılır; rıza orada, önceden işaretsiz kutuyla verilir
  function pencereyiAc() {
    if (!eposta?.reportValidity()) return;
    onay?.showModal();
  }
  ac?.addEventListener('click', pencereyiAc);
  // Adres kutusunda Enter da pencereyi açar (form doğrudan gönderilmez)
  eposta?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    pencereyiAc();
  });
  onay?.querySelector('.liste-vazgec')?.addEventListener('click', () => onay.close());
  onay?.addEventListener('click', (e) => {
    if (e.target === onay) onay.close();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const dugme = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const veri = Object.fromEntries(new FormData(form).entries());
    delete veri.donus;
    if (dugme) {
      dugme.disabled = true;
      dugme.textContent = M.gonderiliyor;
    }
    try {
      const yanit = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(veri),
      });
      const sonuc = await yanit.json().catch(() => ({ durum: 'hata' }));
      if (sonuc.durum === 'tamam') {
        goster(M.tamam, true);
        form.reset();
        window.bumbaOlay?.('liste-katil');
      } else {
        goster(M.hatalar[sonuc.durum] ?? M.hatalar.hata, false);
      }
    } catch {
      goster(M.hatalar.hata, false);
    } finally {
      onay?.close();
      if (dugme) {
        dugme.disabled = false;
        dugme.textContent = M.katil;
      }
    }
  });
</script>

<style>
  /* Masaüstünde başlık ve form yan yana, tek satır; dar ekranda başlık üstte */
  .liste-kutusu {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1.25rem;
  }
  .liste-baslik {
    margin: 0;
    font-size: 1.15rem;
    color: var(--yazi);
  }
  /* Genişlik açıkça verilir: alt bilginin ızgarası bu genişliği bilmezse başlığı forma sığdıramaz */
  .liste-formu {
    flex: 0 1 17rem;
    width: 17rem;
    min-width: 14rem;
  }
  .liste-satir {
    display: flex;
    gap: 0.75rem;
  }
  .liste-satir input {
    flex: 1;
    min-width: 0;
    font: inherit;
    color: var(--yazi);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--cizgi);
    padding: 0.45rem 0.1rem;
    border-radius: 0;
  }
  .liste-satir input:focus-visible {
    outline: none;
    border-bottom-color: var(--vurgu);
  }
  .liste-satir input::placeholder {
    color: var(--soluk);
  }
  /* Telefonda alt bilginin geri kalanı gibi sola yaslı, adres kutusu tam genişlikte */
  @media (max-width: 40rem) {
    .liste-kutusu {
      justify-content: flex-start;
    }
    .liste-formu {
      flex-basis: 100%;
      width: auto;
    }
  }
  /* Onay penceresi */
  .liste-onay {
    width: min(30rem, calc(100vw - 2rem));
    padding: 1.6rem clamp(1.25rem, 4vw, 2rem) 1.5rem;
    border: 1px solid var(--cizgi);
    border-radius: 4px;
    background: var(--zemin);
    color: var(--yazi);
    font-size: 0.95rem;
  }
  .liste-onay::backdrop {
    background: rgba(0, 0, 0, 0.72);
  }
  .liste-onay h3 {
    margin: 0 0 0.75rem;
    font-size: 1.6rem;
  }
  .liste-onay p {
    margin: 0;
    color: var(--soluk);
  }
  .liste-riza {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin-top: 1.1rem;
  }
  .liste-riza input {
    margin-top: 0.3rem;
    accent-color: var(--vurgu);
  }
  .liste-riza a {
    color: var(--yazi);
  }
  .liste-onay-dugmeler {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1.4rem;
  }
  /* JavaScript yoksa pencere açılamaz: içeriği formun altında açık durur, gönderme düğmesi oradadır */
  :global(html:not(.js)) .liste-onay {
    display: block;
    position: static;
    width: auto;
    margin: 0.9rem 0 0;
    padding: 0;
    border: 0;
    background: none;
    font-size: inherit;
  }
  :global(html:not(.js)) .liste-onay h3,
  :global(html:not(.js)) .liste-ac,
  :global(html:not(.js)) .liste-vazgec {
    display: none;
  }
  .bot-tuzagi {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .liste-durum:empty {
    display: none;
  }
  .liste-durum {
    margin: 0.6rem 0 0;
    font-style: italic;
    min-height: 1.2em;
  }
  .liste-durum[data-durum='tamam'] {
    color: var(--yazi);
  }
</style>
