---
import Temel from '../layouts/Temel.astro';
import SiirFotosu from '../components/SiirFotosu.astro';
import { DUYGULAR, duyguAdi, duyguIlgi, renkAdi, type Duygu } from '../data/duygular';
import { dilBul, duyguYolu, metin, siirSayisi, yerAdi, yerde } from '../i18n';
import { SITE } from '../data/site';
import {
  ad,
  anaDuygu,
  gunAy,
  siirYolu,
  tumSiirler,
  uzunTarih,
  type Siir,
} from '../lib/siirler';
import { kunye, siirFotografi } from '../lib/foto';

const dil = dilBul(Astro.url);
const m = metin(dil);
const tum = await tumSiirler();
const bul = (id: string) => tum.find((s) => s.id === id);
const sayilar = Object.fromEntries(DUYGULAR.map((d) => [d.slug, tum.filter((s) => s.data.duygular.includes(d.slug)).length]));

// Vitrin: kitabın ilk mısrası ve her duygunun renginin geçtiği mısra, kendi şiirinin yerinde.
// Her ziyarette biri seçilir; sayfa açıkken yavaşça birbirine geçerler.
interface Vitrin {
  siir: Siir;
  misralar: string[];
  duygu: Duygu;
  /** Mısrada duygunun renginde yazılacak kelime */
  renk?: string;
}
const vitrinler: Vitrin[] = [];
const acilis = bul('2011-07-18-moda');
if (acilis) vitrinler.push({ siir: acilis, misralar: ['Şiir kitabım ağlıyor!'], duygu: anaDuygu(acilis) });
for (const d of DUYGULAR) {
  const s = bul(d.kaynak);
  if (s) vitrinler.push({ siir: s, misralar: d.misra, duygu: d, renk: d.renkAdi });
}

/** Mısrayı renk kelimesinin geçtiği yerden böler: ["Üstünde kaldı ", "sarı", " kediler"] */
function parcala(misra: string, renk?: string): { metin: string; renkli: boolean }[] {
  if (!renk) return [{ metin: misra, renkli: false }];
  const i = misra.toLocaleLowerCase('tr').indexOf(renk.toLocaleLowerCase('tr'));
  if (i < 0) return [{ metin: misra, renkli: false }];
  // kelimenin sonuna kadar renklendir ("Kayısılarım", "mosmor" gibi)
  let son = i + renk.length;
  while (son < misra.length && /[\p{L}]/u.test(misra[son])) son++;
  return [
    { metin: misra.slice(0, i), renkli: false },
    { metin: misra.slice(i, son), renkli: true },
    { metin: misra.slice(son), renkli: false },
  ].filter((p) => p.metin);
}

// "Bugün" kutusunun metin kalıpları (betik doldurur)
const bugunMetin = {
  baslik: m.ana.bugun.baslik('{gunAy}'),
  ayniYer: m.ana.bugun.ayniYer(0, '{yerde}', 0).replace(/\b0\b/, '{n}').replace(/\b0\b/, '{fark}'),
  farkliYillar: m.ana.bugun.farkliYillar(0).replace(/\b0\b/, '{n}'),
  tek: m.ana.bugun.tek('{yil}'),
};

// "Bugün yazılmış şiir" için tarihli şiirlerin gün-ay bilgisi (tarayıcıda bugünle karşılaştırılır)
const takvim = tum
  .filter((s) => s.data.tarih)
  .map((s) => ({
    gun: s.data.tarih!.slice(5),
    yil: s.data.tarih!.slice(0, 4),
    gunAy: gunAy(s.data.tarih!, dil),
    ad: ad(s),
    yer: s.data.yerGrubu ?? s.data.yer ?? null,
    yerde: s.data.yer ? yerde(s.data.yerGrubu ?? s.data.yer, dil) : null,
    href: siirYolu(s, dil),
    renk: anaDuygu(s).nokta,
  }));
---

<Temel sahne sema={[{ '@type': 'WebPage', name: SITE.ad, description: m.site.ozet, inLanguage: dil, isPartOf: { '@id': 'https://duygularinpesinde.bumba.tr/#site' } }]}>
  <h1 class="gorunmez">{SITE.ad}</h1>

  <section class="sahne vitrin" aria-label={m.ana.vitrinAria}>
    {
      vitrinler.map((v, i) => {
        const foto = siirFotografi(v.siir);
        return (
          <div class="vitrin-oge" data-i={i} data-secili={i === 0 ? '' : undefined} style={`--vurgu:${v.duygu.gece}`}>
            <SiirFotosu siir={v.siir} duygu={v.duygu} sizes="100vw" />
            <div class="sahne-ic vitrin-ic">
              <p class="etiket vitrin-etiket">
                {v.renk ? `${duyguAdi(v.duygu, dil)} · ${renkAdi(v.duygu, dil)}` : m.ana.ilkMisra}
              </p>
              <p class="vitrin-misra" lang="tr">
                {v.misralar.map((m, k) => (
                  <>
                    {k > 0 && <br />}
                    {parcala(m, v.renk).map((p) => (p.renkli ? <em>{p.metin}</em> : p.metin))}
                  </>
                ))}
              </p>
              <p class="vitrin-imza">
                {v.siir.data.tarih && <b>{uzunTarih(v.siir.data.tarih, dil)}</b>}
                {v.siir.data.yer && (
                  <span>
                    {' '}
                    · {yerAdi(v.siir.data.yer, dil)}
                    {v.siir.data.yerGrubu && v.siir.data.yerGrubu !== v.siir.data.yer && ` (${v.siir.data.yerGrubu})`}
                  </span>
                )}
              </p>
              <a class="dugme vitrin-oku" href={siirYolu(v.siir, dil)}>
                {m.ana.siiriOku}
              </a>
            </div>
            {foto && (
              <a class="sahne-kunye" href={foto.kaynak} rel="noopener">
                {kunye(foto, dil)}
              </a>
            )}
          </div>
        );
      })
    }
    <button class="dugme vitrin-dur" type="button" hidden data-durdur={m.ana.durdur} data-surdur={m.ana.surdur}>{m.ana.durdur}</button>
    <script is:inline>
      // Her ziyarette başka bir mısra; aynı oturumda sırayla ilerler.
      // Sayfa açıkken mısralar yavaşça birbirine geçer.
      (function () {
        var vitrin = document.querySelector('.vitrin');
        var ogeler = vitrin.querySelectorAll('.vitrin-oge');
        var n = ogeler.length;
        if (!n) return;
        var i;
        function sakla() {
          try {
            sessionStorage.setItem('vitrin', String(i));
          } catch (e) {}
        }
        try {
          var onceki = sessionStorage.getItem('vitrin');
          i = onceki === null ? Math.floor(Math.random() * n) : (Number(onceki) + 1) % n;
        } catch (e) {
          i = Math.floor(Math.random() * n);
        }
        sakla();
        ogeler.forEach(function (o, k) {
          if (k === i) o.setAttribute('data-secili', '');
          else o.removeAttribute('data-secili');
        });
        // Seçilen fotoğraf beklemeden ve öncelikle insin; diğerleri sırası gelince
        var img = ogeler[i].querySelector('img');
        if (img) {
          img.setAttribute('fetchpriority', 'high');
          img.loading = 'eager';
        }

        if (n < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        var SURE = 9000; // her mısra ekranda kalır
        var GECIS = 2400; // fotoğrafların birbirine geçişi
        var dugme = vitrin.querySelector('.vitrin-dur');
        var durduruldu = false;
        var gorunur = true;
        var odak = false;
        var zamanlayici = null;
        var bekliyor = false;

        function calisiyor() {
          return !durduruldu && gorunur && !odak && !document.hidden;
        }
        function kur() {
          clearTimeout(zamanlayici);
          zamanlayici = calisiyor() ? setTimeout(gec, SURE) : null;
        }
        // Sıradakini görünmez hâlde hazırla ki fotoğrafı önceden insin
        function hazirla(k) {
          var o = ogeler[k];
          o.setAttribute('data-sonraki', '');
          var r = o.querySelector('img');
          if (r) r.loading = 'eager';
        }
        function yuklendi(o, sonra) {
          var r = o.querySelector('img');
          if (!r || (r.complete && r.naturalWidth)) return sonra();
          bekliyor = true;
          function bitti() {
            bekliyor = false;
            sonra();
          }
          r.addEventListener('load', bitti, { once: true });
          r.addEventListener('error', bitti, { once: true });
        }
        function gec() {
          zamanlayici = null;
          if (bekliyor || !calisiyor()) return;
          var j = (i + 1) % n;
          var eski = ogeler[i];
          var yeni = ogeler[j];
          if (!yeni.hasAttribute('data-sonraki')) hazirla(j);
          yuklendi(yeni, function () {
            if (!calisiyor()) return;
            vitrin.setAttribute('data-akis', '');
            eski.removeAttribute('data-secili');
            eski.setAttribute('data-onceki', '');
            eski.inert = true;
            yeni.removeAttribute('data-sonraki');
            yeni.setAttribute('data-secili', '');
            i = j;
            sakla();
            setTimeout(function () {
              eski.removeAttribute('data-onceki');
              eski.inert = false;
              hazirla((i + 1) % n);
            }, GECIS + 200);
            kur();
          });
        }

        dugme.hidden = false;
        dugme.addEventListener('click', function () {
          durduruldu = !durduruldu;
          dugme.textContent = durduruldu ? dugme.dataset.surdur : dugme.dataset.durdur;
          kur();
        });
        // Klavyeyle mısraya gelen okurun önünden mısra kaçmasın
        vitrin.addEventListener('focusin', function (e) {
          var t = e.target;
          try {
            odak = t !== dugme && t.matches(':focus-visible');
          } catch (h) {
            odak = t !== dugme;
          }
          kur();
        });
        vitrin.addEventListener('focusout', function (e) {
          if (!vitrin.contains(e.relatedTarget)) {
            odak = false;
            kur();
          }
        });
        document.addEventListener('visibilitychange', kur);
        if ('IntersectionObserver' in window) {
          new IntersectionObserver(
            function (g) {
              gorunur = g[0].isIntersecting;
              kur();
            },
            { threshold: 0.3 },
          ).observe(vitrin);
        }
        // İlk fotoğraf indikten sonra sıradakini hazırla
        window.addEventListener('load', function () {
          hazirla((i + 1) % n);
        });
        kur();
      })();
    </script>
  </section>

  <section class="soru" aria-labelledby="soru-baslik">
    <p class="ana-ozet">{m.site.ozet}</p>
    <h2 id="soru-baslik" class="etiket">{m.ana.soru}</h2>
    <ul class="cipler soru-cipleri">
      {
        DUYGULAR.map((d) => (
          <li>
            <a class="cip" href={duyguYolu(d.slug, dil)} style={`--nokta:${d.nokta}`} data-umami-event="duygu-sec" data-umami-event-duygu={d.slug}>
              <span class="nokta" aria-hidden="true" />
              {duyguIlgi(d, dil)}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <aside class="bugun" id="bugun" hidden aria-live="polite"></aside>

  <section class="duygular" aria-labelledby="duygular-baslik">
    <div class="bolum-bas">
      <h2 id="duygular-baslik">{m.ana.duygularBaslik}</h2>
      <p>{m.ana.duygularAlt}</p>
    </div>
    <ul class="seritler">
      {
        DUYGULAR.map((d) => {
          const s = bul(d.kaynak);
          return (
            <li>
              <a class="serit" href={duyguYolu(d.slug, dil)} style={`--vurgu:${d.gece}`}>
                {s && <SiirFotosu siir={s} duygu={d} sinif="serit-foto" sizes="(min-width: 72rem) 72rem, 100vw" genislikler={[600, 1000, 1500]} />}
                <span class="serit-ad">{duyguAdi(d, dil)}</span>
                <span class="serit-bilgi">
                  {siirSayisi(sayilar[d.slug], dil)}
                  <br />
                  {renkAdi(d, dil)}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

</Temel>

<script is:inline define:vars={{ takvim, ozel: m.ozelGunler, bugunMetin }}>
  window.__takvim = takvim;
  window.__ozel = ozel;
  window.__bugunMetin = bugunMetin;
</script>

<script>
  interface Gun {
    gun: string;
    yil: string;
    gunAy: string;
    ad: string;
    yer: string | null;
    yerde: string | null;
    href: string;
    renk: string;
  }
  const {
    __takvim: takvim,
    __ozel: ozel,
    __bugunMetin: M,
  } = window as unknown as { __takvim: Gun[]; __ozel: Record<string, string>; __bugunMetin: Record<string, string> };
  const doldur = (k: string, d: Record<string, string | number>) => Object.entries(d).reduce((t, [a, v]) => t.replace(`{${a}}`, String(v)), M[k]);
  const simdi = new Date();
  const bugun = `${String(simdi.getMonth() + 1).padStart(2, '0')}-${String(simdi.getDate()).padStart(2, '0')}`;
  const eslesen = takvim.filter((t) => t.gun === bugun);
  const kutu = document.getElementById('bugun');

  if (kutu && eslesen.length) {
    const baslik = document.createElement('p');
    baslik.className = 'etiket';
    baslik.textContent = doldur('baslik', { gunAy: eslesen[0].gunAy });
    const not = document.createElement('p');
    not.className = 'bugun-not';
    const ayniYer = eslesen.length > 1 && eslesen.every((t) => t.yer && t.yer === eslesen[0].yer);
    if (ayniYer) {
      const fark = Number(eslesen[eslesen.length - 1].yil) - Number(eslesen[0].yil);
      not.textContent = doldur('ayniYer', { n: eslesen.length, yerde: eslesen[0].yerde ?? '', fark });
    } else if (eslesen.length > 1) {
      const onEk = ozel[bugun] ? `${ozel[bugun][0].toLocaleUpperCase(document.documentElement.lang)}${ozel[bugun].slice(1)}. ` : '';
      not.textContent = onEk + doldur('farkliYillar', { n: eslesen.length });
    } else {
      not.textContent = doldur('tek', { yil: eslesen[0].yil });
    }
    const liste = document.createElement('ul');
    liste.className = 'cipler';
    for (const t of eslesen) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.className = 'cip';
      a.href = t.href;
      a.style.setProperty('--nokta', t.renk);
      const nokta = document.createElement('span');
      nokta.className = 'nokta';
      a.append(nokta, `${t.ad} · ${t.yil}`);
      li.append(a);
      liste.append(li);
    }
    kutu.append(baslik, not, liste);
    kutu.hidden = false;
  }
</script>

<style>
  /* ---------- Vitrin ---------- */
  .vitrin {
    min-height: min(100svh, 60rem);
    align-items: stretch;
  }
  .vitrin::after {
    display: none;
  }
  /* Mısralar üst üste durur; görünen (secili), az önce görünen (onceki) ve sıradaki (sonraki) */
  .vitrin-oge {
    display: none;
    grid-area: 1 / 1;
    position: relative;
    min-height: inherit;
  }
  .vitrin-oge[data-secili],
  .vitrin-oge[data-onceki],
  .vitrin-oge[data-sonraki] {
    display: grid;
    align-items: end;
  }
  .vitrin-oge[data-secili] {
    z-index: 2;
  }
  .vitrin-oge[data-onceki] {
    z-index: 1;
  }
  .vitrin-oge[data-sonraki] {
    opacity: 0;
    visibility: hidden;
  }
  /* Yeni fotoğraf eskisinin üstünde yavaşça belirir; yazı önce söner, sonra yenisi gelir */
  .vitrin[data-akis] .vitrin-oge[data-secili] {
    animation: vitrin-belir 2.4s ease-in-out both;
  }
  .vitrin[data-akis] .vitrin-oge[data-secili] > .vitrin-ic,
  .vitrin[data-akis] .vitrin-oge[data-secili] > .sahne-kunye {
    animation: vitrin-yazi 1.4s 1.3s ease-out both;
  }
  .vitrin-oge[data-onceki] > .vitrin-ic,
  .vitrin-oge[data-onceki] > .sahne-kunye {
    animation: vitrin-sil 0.7s ease-in both;
  }
  @keyframes vitrin-belir {
    from {
      opacity: 0;
    }
  }
  @keyframes vitrin-yazi {
    from {
      opacity: 0;
      transform: translateY(0.6rem);
    }
  }
  @keyframes vitrin-sil {
    to {
      opacity: 0;
    }
  }
  .vitrin-dur {
    position: absolute;
    z-index: 3;
    right: var(--kenar);
    bottom: 2.2rem;
    padding: 0.4rem 0;
    font-size: 0.6rem;
    color: color-mix(in srgb, var(--yazi) 45%, transparent);
  }
  .vitrin-oge > :global(.foto) {
    position: absolute;
    inset: 0;
  }
  .vitrin-oge::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.35) 0%,
      transparent 20%,
      transparent 40%,
      color-mix(in srgb, var(--zemin) 82%, transparent) 74%,
      var(--zemin) 100%
    );
    pointer-events: none;
  }
  .vitrin-ic {
    padding-bottom: 3rem;
  }
  .vitrin-etiket {
    color: var(--vurgu);
  }
  .vitrin-misra {
    font-family: var(--serif-baslik);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(2.6rem, 1.6rem + 5vw, 5.6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0.9rem 0 1.1rem;
    max-width: 15ch;
    text-wrap: balance;
  }
  .vitrin-misra em {
    color: var(--vurgu);
  }
  .vitrin-imza {
    margin: 0;
    font-family: var(--etiket);
    font-size: 0.82rem;
    color: color-mix(in srgb, var(--yazi) 70%, transparent);
  }
  .vitrin-imza b {
    font-weight: 500;
    color: var(--yazi);
  }
  .vitrin-oku {
    margin-top: 0.4rem;
    color: var(--yazi);
  }

  /* ---------- Soru ---------- */
  .ana-ozet {
    max-width: 40rem;
    margin: 1.5rem 0 2rem;
    color: var(--soluk);
    font-size: 1.05rem;
  }
  .soru {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1rem var(--kenar) 0;
  }
  .soru h2 {
    margin-bottom: 1rem;
  }

  .bugun {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3rem var(--kenar) 0;
  }
  .bugun :global(.bugun-not) {
    margin: 0.4rem 0 1rem;
    font-family: var(--serif-baslik);
    font-style: italic;
    font-weight: 300;
    font-size: 1.5rem;
  }

  .bolum-bas {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
    max-width: 40rem;
  }
  .bolum-bas h2 {
    font-size: clamp(2.2rem, 1.6rem + 2.6vw, 3.6rem);
  }
  .bolum-bas p {
    margin: 0;
    color: var(--soluk);
  }

  /* ---------- Yedi duygu: fotoğraflı şeritler ---------- */
  .duygular {
    max-width: 72rem;
    margin: 0 auto;
    padding: 6rem var(--kenar) 0;
  }
  .seritler {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .serit {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    height: clamp(6.5rem, 4rem + 9vw, 11rem);
    padding: 0 1.1rem 0.9rem;
    overflow: hidden;
    text-decoration: none;
  }
  .serit > :global(.foto) {
    position: absolute;
    inset: 0;
    z-index: 0;
    transition: transform 1.2s ease;
  }
  .serit::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.55), transparent 55%, rgba(0, 0, 0, 0.5));
  }
  .serit:hover > :global(.foto) {
    transform: scale(1.04);
  }
  .serit-ad {
    position: relative;
    z-index: 1;
    font-family: var(--serif-baslik);
    font-weight: 300;
    font-size: clamp(2.6rem, 1.8rem + 4vw, 5.4rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .serit-bilgi {
    position: relative;
    z-index: 1;
    font-family: var(--etiket);
    font-weight: 600;
    font-size: 0.64rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-align: right;
    line-height: 1.6;
    color: var(--vurgu);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
  }

</style>
