---
import Temel from '../layouts/Temel.astro';
import SiirSahnesi from '../components/SiirSahnesi.astro';
import SiirFotosu from '../components/SiirFotosu.astro';
import SiirGovde from '../components/SiirGovde.astro';
import MisraKarti from '../components/MisraKarti.astro';
import OrtamSesi from '../components/OrtamSesi.astro';
import PaylasMenusu from '../components/PaylasMenusu.astro';
import Sesler from '../components/Sesler.astro';
import { SITE } from '../data/site';
import { DUYGU_ORTAMI } from '../data/ortam-sesleri';
import {
  ad,
  anaDuygu,
  basliksiz,
  ilkMisra,
  imza,
  kapilar,
  siirDuygulari,
  siirYolu,
  type Siir,
} from '../lib/siirler';
import { duyguAdi } from '../data/duygular';
import { dilBul, duyguYolu, kucuk, metin, sayfaYolu } from '../i18n';
import { siirSema } from '../lib/sema';

interface Props {
  siir: Siir;
  onceki?: Siir;
  sonraki?: Siir;
  tum: Siir[];
}

const { siir, onceki, sonraki, tum } = Astro.props;
const dil = dilBul(Astro.url);
const m = metin(dil);
const sira = tum.findIndex((x) => x.id === siir.id) + 1;
const d = anaDuygu(siir);
const im = imza(siir, dil);
const ogGorsel = dil === 'en' ? `/og/en/${siir.id}.jpg` : `/og/${siir.id}.jpg`;
const sayfaBasligi = basliksiz(siir) ? `${ilkMisra(siir)}…` : ad(siir);
const aciklama = m.siir.aciklama(ilkMisra(siir), im);
// Şairin kendi kaydı en başta, varsa örnekler arkada
const kayitlar = [
  ...(siir.data.ses ? [{ dosya: siir.data.ses, etiket: m.siir.sesliDinle }] : []),
  ...(siir.data.sesler ?? []),
];
---

<Temel
  baslik={sayfaBasligi + m.siir.baslikEki}
  aciklama={aciklama}
  gorsel={ogGorsel}
  duygu={d}
  sahne
  sinif="siir-sayfasi"
  sema={[siirSema(siir, dil, ogGorsel)]}
  kirinti={[
    { ad: m.sayfaAdlari.siirler, yol: sayfaYolu('siirler', dil) },
    { ad: ad(siir), yol: siirYolu(siir, dil) },
  ]}
>
  <div class="siir-duzen">
    <SiirSahnesi siir={siir} etiket={`${duyguAdi(d, dil)} · ${sira} / ${tum.length}`} oncelik sizes="(min-width: 64rem) 52vw, 100vw" />

    <article class="sayfa siir tek">
      {kayitlar.length > 0 && <Sesler kayitlar={kayitlar} />}
      <p class="ipucu" id="ipucu" aria-hidden="true">{m.siir.hepsiIcin}</p>
      <SiirGovde siir={siir} id="govde" acilis="hemen" />
      <p class="imza-satiri">— {SITE.sair}</p>
      {m.genel.siirlerTurkce && <p class="dil-notu">{m.genel.siirlerTurkce}</p>}

      <div class="arac">
        <button class="dugme" type="button" id="bastan-oku">{m.siir.bastanOku}</button>
        <button class="dugme" type="button" id="kart-dugme" aria-pressed="false">{m.siir.misraKarti}</button>
        <PaylasMenusu baslik={sayfaBasligi} />
        <OrtamSesi varsayilan={siir.data.ortam ?? DUYGU_ORTAMI[d.slug]} duygu={d.slug} />
        <button class="dugme vurgulu" type="button" id="kart-olustur" hidden>{m.siir.kartOlustur}</button>
      </div>
      <p class="durum" id="durum" role="status" aria-live="polite"></p>

      <ul class="cipler siir-duygulari" aria-label={m.siir.duygular}>
        {
          siirDuygulari(siir).map((x) => (
            <li>
              <a class="cip" href={duyguYolu(x.slug, dil)} style={`--nokta:${x.nokta}`}>
                <span class="nokta" aria-hidden="true" />
                {kucuk(duyguAdi(x, dil), dil)}
              </a>
            </li>
          ))
        }
      </ul>

      <nav class="kapilar" aria-labelledby="kapilar-baslik">
        <p class="etiket" id="kapilar-baslik">{m.siir.buradanNereye}</p>
        {
          kapilar(siir, tum, dil).map((k) => (
            <a class="kapi" href={siirYolu(k.siir, dil)}>
              <SiirFotosu siir={k.siir} sinif="kapi-foto" sizes="88px" genislikler={[200]} />
              <span class="kapi-metin">
                <span class="kapi-etiket">
                  {k.etiket} · {k.deger}
                </span>
                <span class={basliksiz(k.siir) ? 'kapi-ad ilk' : 'kapi-ad'}>{ad(k.siir)}</span>
                <span class="kapi-ok">{imza(k.siir, dil) || m.genel.tarihsiz} →</span>
              </span>
            </a>
          ))
        }
      </nav>

      <nav class="sira" aria-label={m.siir.siradakiler}>
        {onceki && <a href={siirYolu(onceki, dil)}>← {ad(onceki)}</a>}
        {sonraki && <a class="sonraki" href={siirYolu(sonraki, dil)}>{ad(sonraki)} →</a>}
      </nav>
    </article>
  </div>
  <MisraKarti siir={siir} />
</Temel>

<script>
  import { acilisSuresi, bastanOku, hepsiniGoster, satirSatir } from '../scripts/acilis';

  const govde = document.getElementById('govde');
  const ipucu = document.getElementById('ipucu');
  let sayac: number | undefined;

  function ipucunuZamanla() {
    window.clearTimeout(sayac);
    ipucu?.classList.remove('bitti');
    if (govde) sayac = window.setTimeout(() => ipucu?.classList.add('bitti'), acilisSuresi(govde));
  }

  if (govde) {
    satirSatir(govde);
    ipucunuZamanla();
    govde.addEventListener('hepsi', () => {
      window.clearTimeout(sayac);
      ipucu?.classList.add('bitti');
    });
    document.getElementById('bastan-oku')?.addEventListener('click', () => {
      bastanOku(govde);
      ipucunuZamanla();
      govde.closest('article')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    // Klavyeyle okuyan için: herhangi bir tuş hepsini getirir (bir düğmedeyken değil)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Tab' || e.metaKey || e.ctrlKey || e.altKey) return;
      if (document.activeElement && document.activeElement !== document.body) return;
      hepsiniGoster(govde);
    });
  }

</script>

<style>
  /* Bilgisayarda fotoğraf solda sabit durur, şiir sağda akar */
  @media (min-width: 64rem) {
    .siir-duzen {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      align-items: start;
    }
    .siir-duzen > :global(.siir-sahne) {
      position: sticky;
      top: 0;
      height: 100vh;
      min-height: 0;
    }
    .siir-duzen > .siir {
      margin: 0;
      padding: 8rem clamp(2rem, 4vw, 4rem) 4rem;
      max-width: 42rem;
    }
  }
</style>
