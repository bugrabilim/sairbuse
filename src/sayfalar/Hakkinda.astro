---
import Temel from '../layouts/Temel.astro';
import SayfaSahnesi from '../components/SayfaSahnesi.astro';
import { SITE } from '../data/site';
import { DUYGULAR, duyguAdi, renkAdi } from '../data/duygular';
import { FOTOGRAFLAR } from '../data/fotograflar';
import { ad, imza, siirYolu, tumSiirler } from '../lib/siirler';
import { fotoAciklama, lisansAdi, siirFotografi } from '../lib/foto';
import { SAYFALAR, dilBul, duyguYolu, metin, type SayfaAdi } from '../i18n';

const dil = dilBul(Astro.url);
const M = metin(dil);
const m = M.hakkinda;
const tum = await tumSiirler();
const acilis = tum.find((s) => s.id === '2011-07-18-moda');
const antigoni = tum.find((s) => s.id === '2011-10-24-antigoni');
const renkler = DUYGULAR.map((d) => ({ d, kaynak: tum.find((s) => s.id === d.kaynak) }));
// Her fotoğraf ve onu kullanan şiirler
const fotolar = FOTOGRAFLAR.map((f) => ({ f, siirler: tum.filter((s) => siirFotografi(s)?.id === f.id) })).filter(
  (x) => x.siirler.length || x.f.sayfa,
);
/** Fotoğrafın başında durduğu sayfa, o dilde (ad ve adres) */
function sayfasi(yol: string) {
  const anahtar = (Object.keys(SAYFALAR) as SayfaAdi[]).find((k) => SAYFALAR[k].tr === yol);
  return anahtar ? { ad: M.sayfaAdlari[anahtar], yol: SAYFALAR[anahtar][dil] } : undefined;
}
const [antigoniOnce, antigoniSonra] = m.antigoni.split('{siir}');
---

<Temel baslik={m.baslik} aciklama={m.aciklama} sahne>
  <SayfaSahnesi foto="sayfa-hakkinda" duygu="karanlik" etiket={SITE.ad} baslik={m.baslik} />
  <article class="sayfa hakkinda">
    <p>{m.giris1}</p>
    <p>{m.giris2}</p>
    <blockquote lang="tr">
      <p>Şiir kitabım ağlıyor!<br />…<br />Yaşayamazmış<br />Böyle ağlarmış</p>
      {acilis && <cite><a href={siirYolu(acilis, dil)}>{imza(acilis, dil)}</a></cite>}
    </blockquote>
    <p>{m.giris3}</p>

    <h2>{m.renkler}</h2>
    <p>{m.renklerGiris}</p>
    <ul class="renkler">
      {
        renkler.map(({ d, kaynak }) => (
          <li style={`--nokta:${d.nokta}`}>
            <span class="nokta buyuk" aria-hidden="true" />
            <span class="renk-ad">
              <a href={duyguYolu(d.slug, dil)}>{duyguAdi(d, dil)}</a> · {renkAdi(d, dil)}
            </span>
            <span class="renk-misra" lang="tr">
              {d.misra.join(' / ')}
              {kaynak && <> — <a href={siirYolu(kaynak, dil)}>{imza(kaynak, dil)}</a></>}
            </span>
          </li>
        ))
      }
    </ul>

    <h2>{m.imza}</h2>
    <p>
      {m.imzaMetni(SITE.sair)}{' '}
      {
        SITE.sair === 'Antigoni' && antigoni && (
          <>
            {antigoniOnce}<a href={siirYolu(antigoni, dil)}>{m.antigoniBag}</a>{antigoniSonra}
          </>
        )
      }
    </p>

    <p class="foto-ac-satir">
      <button class="dugme vurgulu" type="button" id="fotograflar" aria-haspopup="dialog" aria-controls="foto-pencere">{m.fotograflariGor}</button>
    </p>
    <dialog class="foto-pencere" id="foto-pencere" aria-labelledby="foto-baslik">
      <div class="foto-pencere-bas">
        <h2 id="foto-baslik">{m.fotograflar}</h2>
        <button class="dugme" type="button" id="foto-kapat">{M.kart.kapat}</button>
      </div>
      <p>{m.fotoMetni}</p>
      <ul class="kunyeler">
        {
          fotolar.map(({ f, siirler }) => {
            const sf = f.sayfa ? sayfasi(f.sayfa.yol) : undefined;
            return (
              <li>
                <span class="kunye-aciklama">{fotoAciklama(f, dil)}</span>
                <span class="kunye-kim">
                  <a href={f.kaynak} rel="noopener">{f.yazar}</a> · <a href={f.lisansUrl} rel="noopener">{lisansAdi(f, dil)}</a> · {M.foto.renkleriDegisti}
                </span>
                <span class="kunye-siir">
                  {sf && <a href={sf.yol}>{m.sayfasi(sf.ad)}</a>}
                  {sf && siirler.length > 0 && ', '}
                  {siirler.map((s, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={siirYolu(s, dil)}>{ad(s)}</a>
                    </>
                  ))}
                </span>
              </li>
            );
          })
        }
      </ul>
    </dialog>

    <h2 id="haklar">{m.haklar}</h2>
    <p>{m.haklarMetni}</p>
    <p>{m.fotoHaklar}</p>
  </article>
</Temel>

<script>
  // Fotoğraf künyeleri bir pencerede; alt bilgideki "künyeler" bağlantısı (#fotograflar) pencereyi açar
  const pencere = document.getElementById('foto-pencere') as HTMLDialogElement | null;
  const ac = document.getElementById('fotograflar');
  ac?.addEventListener('click', () => pencere?.showModal());
  document.getElementById('foto-kapat')?.addEventListener('click', () => pencere?.close());
  pencere?.addEventListener('click', (e) => {
    if (e.target === pencere) pencere.close();
  });
  function hashKontrol() {
    if (location.hash === '#fotograflar' && pencere && !pencere.open) pencere.showModal();
  }
  hashKontrol();
  window.addEventListener('hashchange', hashKontrol);
</script>

<style>
  .foto-ac-satir {
    margin: 2.5rem 0 1rem;
  }
  .foto-pencere {
    width: min(46rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 3rem);
    padding: 0 clamp(1.25rem, 4vw, 2.5rem) 2rem;
    border: 1px solid var(--cizgi);
    border-radius: 4px;
    background: var(--zemin);
    color: var(--yazi);
    overflow-y: auto;
  }
  .foto-pencere::backdrop {
    background: rgba(0, 0, 0, 0.72);
  }
  .foto-pencere-bas {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0 0.75rem;
    background: var(--zemin);
    border-bottom: 1px solid var(--cizgi);
    margin-bottom: 1rem;
  }
  .foto-pencere-bas h2 {
    margin: 0 !important;
  }
  /* JavaScript yoksa künyeler sayfada açık durur */
  :global(html:not(.js)) .foto-pencere {
    display: block;
    position: static;
    width: auto;
    max-height: none;
    border: 0;
    padding: 0;
  }
  :global(html:not(.js)) .foto-ac-satir,
  :global(html:not(.js)) #foto-kapat {
    display: none;
  }
  .hakkinda {
    max-width: 38rem;
  }
  .hakkinda h2 {
    font-size: 2.2rem;
    font-style: italic;
    margin: 3rem 0 0.75rem;
  }
  .hakkinda blockquote {
    margin: 1.5rem 0;
    padding-left: 1.1rem;
    border-left: 2px solid var(--cizgi);
    font-style: italic;
    font-size: 1.25rem;
  }
  .hakkinda blockquote p {
    margin: 0 0 0.3rem;
  }
  .hakkinda cite {
    font-style: normal;
    font-size: 0.95rem;
    color: var(--soluk);
  }
  .renkler {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 1rem;
  }
  .renkler li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.9rem;
    align-items: center;
  }
  .nokta.buyuk {
    width: 1.6rem;
    height: 1.6rem;
    grid-row: span 2;
  }
  .renk-ad a {
    font-family: var(--serif-baslik);
    font-size: 1.3rem;
    font-weight: 300;
    text-decoration: none;
  }
  .renk-ad {
    color: var(--soluk);
  }
  .renk-misra {
    font-style: italic;
    color: var(--soluk);
    font-size: 1rem;
  }
  .renk-misra a {
    font-style: normal;
  }
  .kunyeler {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 1rem;
    font-size: 0.98rem;
  }
  .kunyeler li {
    display: grid;
    gap: 0.1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--cizgi);
  }
  .kunye-aciklama {
    font-style: italic;
  }
  .kunye-kim,
  .kunye-siir {
    color: var(--soluk);
    font-size: 0.92rem;
  }
</style>
