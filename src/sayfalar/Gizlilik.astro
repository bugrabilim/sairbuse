---
// Gizlilik ve çerezler sayfası (aynı metin Hakkında'daki pencerede de var)
import Temel from '../layouts/Temel.astro';
import SayfaSahnesi from '../components/SayfaSahnesi.astro';
import GizlilikMetni from '../components/GizlilikMetni.astro';
import { sayfaYolu, dilBul, metin } from '../i18n';

const dil = dilBul(Astro.url);
const m = metin(dil).gizlilik;
---

<Temel baslik={m.baslik} aciklama={m.aciklama} sahne kirinti={[{ ad: metin(dil).sayfaAdlari.gizlilik, yol: sayfaYolu('gizlilik', dil) }]}>
  <SayfaSahnesi foto="imge-mum" duygu="karanlik" etiket={m.etiket} baslik={m.baslik} />
  <article class="sayfa gizlilik">
    <GizlilikMetni />
  </article>
</Temel>

<style>
  .gizlilik {
    max-width: 38rem;
  }
</style>
