---
import Temel from '../../layouts/Temel.astro';
import SiirBasligi from '../../components/SiirBasligi.astro';
import SiirGovde from '../../components/SiirGovde.astro';
import MisraKarti from '../../components/MisraKarti.astro';
import OrtamSesi from '../../components/OrtamSesi.astro';
import Sesler from '../../components/Sesler.astro';
import {
  ad,
  anaDuygu,
  basliksiz,
  ilkMisra,
  imza,
  kapilar,
  siirDuygulari,
  siirYolu,
  tumSiirler,
  type Siir,
} from '../../lib/siirler';

export async function getStaticPaths() {
  const tum = await tumSiirler();
  return tum.map((siir, i) => ({
    params: { slug: siir.id },
    props: { siir, onceki: tum[i - 1], sonraki: tum[i + 1], tum },
  }));
}

interface Props {
  siir: Siir;
  onceki?: Siir;
  sonraki?: Siir;
  tum: Siir[];
}

const { siir, onceki, sonraki, tum } = Astro.props;
const d = anaDuygu(siir);
const im = imza(siir);
const sayfaBasligi = basliksiz(siir) ? `${ilkMisra(siir)}…` : ad(siir);
const aciklama = [ilkMisra(siir), im].filter(Boolean).join(' — ');
// Şairin kendi kaydı en başta, varsa örnekler arkada
const kayitlar = [
  ...(siir.data.ses ? [{ dosya: siir.data.ses, etiket: 'Şairin sesinden dinle' }] : []),
  ...(siir.data.sesler ?? []),
];
---

<Temel baslik={sayfaBasligi} aciklama={aciklama} gorsel={`/og/${siir.id}.png`} duygu={d}>
  <article class="sayfa siir tek">
    <SiirBasligi siir={siir} />
    {kayitlar.length > 0 && <Sesler kayitlar={kayitlar} />}
    <p class="ipucu" id="ipucu" aria-hidden="true">Hepsi için şiire dokun.</p>
    <SiirGovde siir={siir} id="govde" acilis="hemen" />

    <div class="arac">
      <button class="dugme" type="button" id="bastan-oku">Baştan oku</button>
      <button class="dugme" type="button" id="kart-dugme" aria-pressed="false">Mısra kartı</button>
      <button class="dugme" type="button" id="paylas" data-baslik={sayfaBasligi}>Paylaş</button>
      <OrtamSesi />
      <button class="dugme vurgulu" type="button" id="kart-olustur" hidden>Kartı oluştur</button>
    </div>
    <p class="durum" id="durum" role="status" aria-live="polite"></p>

    <ul class="cipler siir-duygulari" aria-label="Duygular">
      {
        siirDuygulari(siir).map((x) => (
          <li>
            <a class="cip" href={`/duygu/${x.slug}/`} style={`--nokta:${x.nokta}`}>
              <span class="nokta" aria-hidden="true" />
              {x.ad.toLocaleLowerCase('tr')}
            </a>
          </li>
        ))
      }
    </ul>

    <nav class="kapilar" aria-label="Buradan nereye">
      {
        kapilar(siir, tum).map((k) => (
          <a class="kapi" href={siirYolu(k.siir)}>
            <span class="kapi-etiket">
              {k.etiket} · {k.deger}
            </span>
            <span class={basliksiz(k.siir) ? 'kapi-ad ilk' : 'kapi-ad'}>{ad(k.siir)}</span>
            <span class="kapi-ok">{imza(k.siir) || 'tarihsiz'} →</span>
          </a>
        ))
      }
    </nav>

    <nav class="sira" aria-label="Sıradaki şiirler">
      {onceki && <a href={siirYolu(onceki)}>← {ad(onceki)}</a>}
      {sonraki && <a class="sonraki" href={siirYolu(sonraki)}>{ad(sonraki)} →</a>}
    </nav>
  </article>
  <MisraKarti siir={siir} />
</Temel>

<script>
  import { acilisSuresi, bastanOku, hepsiniGoster, satirSatir } from '../../scripts/acilis';

  const govde = document.getElementById('govde');
  const ipucu = document.getElementById('ipucu');
  const durum = document.getElementById('durum');
  let sayac: number | undefined;

  function ipucunuZamanla() {
    window.clearTimeout(sayac);
    ipucu?.classList.remove('bitti');
    if (govde) sayac = window.setTimeout(() => ipucu?.classList.add('bitti'), acilisSuresi(govde));
  }

  if (govde) {
    satirSatir(govde);
    ipucunuZamanla();
    govde.addEventListener('hepsi', () => {
      window.clearTimeout(sayac);
      ipucu?.classList.add('bitti');
    });
    document.getElementById('bastan-oku')?.addEventListener('click', () => {
      bastanOku(govde);
      ipucunuZamanla();
      govde.closest('article')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    // Klavyeyle okuyan için: herhangi bir tuş hepsini getirir (bir düğmedeyken değil)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Tab' || e.metaKey || e.ctrlKey || e.altKey) return;
      if (document.activeElement && document.activeElement !== document.body) return;
      hepsiniGoster(govde);
    });
  }

  const paylas = document.getElementById('paylas');
  paylas?.addEventListener('click', async () => {
    const url = location.href;
    const title = paylas.dataset.baslik ?? document.title;
    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch {
        /* vazgeçildi */
      }
      return;
    }
    try {
      await navigator.clipboard.writeText(url);
      if (durum) durum.textContent = 'Bağlantı kopyalandı.';
    } catch {
      if (durum) durum.textContent = url;
    }
  });
</script>
