---
import Temel from '../layouts/Temel.astro';
import SiirListesi from '../components/SiirListesi.astro';
import SayfaSahnesi from '../components/SayfaSahnesi.astro';
import { DUYGULAR } from '../data/duygular';
import { tumSiirler } from '../lib/siirler';

const tum = await tumSiirler();
---

<Temel baslik="Bütün şiirler" aciklama={`${tum.length} şiir, yazıldıkları sırayla.`} sahne>
  <SayfaSahnesi foto="sayfa-siirler" duygu="ozgurluk" etiket={`${tum.length} şiir`} baslik="Bütün şiirler">
    Yazıldıkları sırayla. Adı olmayan şiirler ilk mısralarıyla anılıyor.
  </SayfaSahnesi>
  <section class="sayfa">

    <div class="suzgec" role="group" aria-label="Duyguya göre süz" hidden>
      <button class="dugme" type="button" data-duygu="" aria-pressed="true">hepsi</button>
      {
        DUYGULAR.map((d) => (
          <button class="dugme" type="button" data-duygu={d.slug} aria-pressed="false">
            <span class="nokta" style={`--nokta:${d.nokta}`} aria-hidden="true" />
            {d.ad.toLocaleLowerCase('tr')}
          </button>
        ))
      }
    </div>

    <SiirListesi siirler={tum} />
  </section>
</Temel>

<script>
  const suzgec = document.querySelector<HTMLElement>('.suzgec');
  const dugmeler = Array.from(document.querySelectorAll<HTMLButtonElement>('.suzgec button'));
  const ogeler = Array.from(document.querySelectorAll<HTMLElement>('.liste-oge'));
  if (suzgec) suzgec.hidden = false;
  for (const b of dugmeler) {
    b.addEventListener('click', () => {
      const secilen = b.dataset.duygu ?? '';
      dugmeler.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      for (const o of ogeler) {
        const duygular = (o.dataset.duygular ?? '').split(' ');
        o.hidden = secilen !== '' && !duygular.includes(secilen);
      }
    });
  }
</script>

<style>
  .suzgec {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 2rem 0 1.5rem;
  }
</style>
