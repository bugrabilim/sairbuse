---
import Temel from '../layouts/Temel.astro';
import SiirFotosu from '../components/SiirFotosu.astro';
import { DUYGULAR, type Duygu } from '../data/duygular';
import { SITE } from '../data/site';
import { UZAK_YERLER } from '../data/yerler';
import {
  OZEL_GUNLER,
  ad,
  anaDuygu,
  bulunma,
  gunAy,
  siirYolu,
  tumSiirler,
  uzunTarih,
  yerler,
  yerYolu,
  type Siir,
} from '../lib/siirler';
import { kunye, siirFotografi } from '../lib/foto';

const tum = await tumSiirler();
const bul = (id: string) => tum.find((s) => s.id === id);
const sayilar = Object.fromEntries(DUYGULAR.map((d) => [d.slug, tum.filter((s) => s.data.duygular.includes(d.slug)).length]));

// Vitrin: kitabın ilk mısrası ve her duygunun renginin geçtiği mısra, kendi şiirinin yerinde.
// Her ziyarette biri seçilir.
interface Vitrin {
  siir: Siir;
  misralar: string[];
  duygu: Duygu;
  /** Mısrada duygunun renginde yazılacak kelime */
  renk?: string;
}
const vitrinler: Vitrin[] = [];
const acilis = bul('2011-07-18-moda');
if (acilis) vitrinler.push({ siir: acilis, misralar: ['Şiir kitabım ağlıyor!'], duygu: anaDuygu(acilis) });
for (const d of DUYGULAR) {
  const s = bul(d.kaynak);
  if (s) vitrinler.push({ siir: s, misralar: d.misra, duygu: d, renk: d.renkAdi });
}

/** Mısrayı renk kelimesinin geçtiği yerden böler: ["Üstünde kaldı ", "sarı", " kediler"] */
function parcala(misra: string, renk?: string): { metin: string; renkli: boolean }[] {
  if (!renk) return [{ metin: misra, renkli: false }];
  const i = misra.toLocaleLowerCase('tr').indexOf(renk.toLocaleLowerCase('tr'));
  if (i < 0) return [{ metin: misra, renkli: false }];
  // kelimenin sonuna kadar renklendir ("Kayısılarım", "mosmor" gibi)
  let son = i + renk.length;
  while (son < misra.length && /[\p{L}]/u.test(misra[son])) son++;
  return [
    { metin: misra.slice(0, i), renkli: false },
    { metin: misra.slice(i, son), renkli: true },
    { metin: misra.slice(son), renkli: false },
  ].filter((p) => p.metin);
}

const yerListesi = yerler(tum);

// "Bugün yazılmış şiir" için tarihli şiirlerin gün-ay bilgisi (tarayıcıda bugünle karşılaştırılır)
const takvim = tum
  .filter((s) => s.data.tarih)
  .map((s) => ({
    gun: s.data.tarih!.slice(5),
    yil: s.data.tarih!.slice(0, 4),
    gunAy: gunAy(s.data.tarih!),
    ad: ad(s),
    yer: s.data.yerGrubu ?? s.data.yer ?? null,
    yerde: s.data.yer ? bulunma(s.data.yerGrubu ?? s.data.yer) : null,
    href: siirYolu(s),
    renk: anaDuygu(s).nokta,
  }));
---

<Temel sahne>
  <h1 class="gorunmez">{SITE.ad}</h1>

  <section class="sahne vitrin" aria-label="Bir mısra">
    {
      vitrinler.map((v, i) => {
        const foto = siirFotografi(v.siir);
        return (
          <div class="vitrin-oge" data-i={i} data-secili={i === 0 ? '' : undefined} style={`--vurgu:${v.duygu.gece}`}>
            <SiirFotosu siir={v.siir} duygu={v.duygu} sizes="100vw" />
            <div class="sahne-ic vitrin-ic">
              <p class="etiket vitrin-etiket">
                {v.renk ? `${v.duygu.ad} · ${v.duygu.renkAdi}` : 'Kitabın ilk mısrası'}
              </p>
              <p class="vitrin-misra">
                {v.misralar.map((m, k) => (
                  <>
                    {k > 0 && <br />}
                    {parcala(m, v.renk).map((p) => (p.renkli ? <em>{p.metin}</em> : p.metin))}
                  </>
                ))}
              </p>
              <p class="vitrin-imza">
                {v.siir.data.tarih && <b>{uzunTarih(v.siir.data.tarih)}</b>}
                {v.siir.data.yer && (
                  <span>
                    {' '}
                    · {v.siir.data.yer}
                    {v.siir.data.yerGrubu && v.siir.data.yerGrubu !== v.siir.data.yer && ` (${v.siir.data.yerGrubu})`}
                  </span>
                )}
              </p>
              <a class="dugme vitrin-oku" href={siirYolu(v.siir)}>
                Şiiri oku →
              </a>
            </div>
            {foto && (
              <a class="sahne-kunye" href={foto.kaynak} rel="noopener">
                {kunye(foto)}
              </a>
            )}
          </div>
        );
      })
    }
    <script is:inline>
      // Her ziyarette başka bir mısra; aynı oturumda sırayla ilerler
      (function () {
        var ogeler = document.querySelectorAll('.vitrin-oge');
        var n = ogeler.length;
        if (!n) return;
        var i;
        try {
          var onceki = sessionStorage.getItem('vitrin');
          i = onceki === null ? Math.floor(Math.random() * n) : (Number(onceki) + 1) % n;
          sessionStorage.setItem('vitrin', String(i));
        } catch (e) {
          i = Math.floor(Math.random() * n);
        }
        ogeler.forEach(function (o, k) {
          if (k === i) o.setAttribute('data-secili', '');
          else o.removeAttribute('data-secili');
        });
        // Seçilen fotoğraf beklemeden ve öncelikle insin (diğerleri hiç inmez)
        var img = ogeler[i].querySelector('img');
        if (img) {
          img.setAttribute('fetchpriority', 'high');
          img.loading = 'eager';
        }
      })();
    </script>
  </section>

  <section class="soru" aria-labelledby="soru-baslik">
    <h2 id="soru-baslik" class="etiket">Bugün neyin peşindesin?</h2>
    <ul class="cipler soru-cipleri">
      {
        DUYGULAR.map((d) => (
          <li>
            <a class="cip" href={`/duygu/${d.slug}/`} style={`--nokta:${d.nokta}`} data-umami-event="duygu-sec" data-umami-event-duygu={d.slug}>
              <span class="nokta" aria-hidden="true" />
              {d.ilgi}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <aside class="bugun" id="bugun" hidden aria-live="polite"></aside>

  <section class="duygular" aria-labelledby="duygular-baslik">
    <div class="bolum-bas">
      <h2 id="duygular-baslik">Yedi duygu, yedi renk</h2>
      <p>Her rengin adı şiirlerin içinden: pembe küpe çiçeği, sarı kediler, turuncu bir gemi.</p>
    </div>
    <ul class="seritler">
      {
        DUYGULAR.map((d) => {
          const s = bul(d.kaynak);
          return (
            <li>
              <a class="serit" href={`/duygu/${d.slug}/`} style={`--vurgu:${d.gece}`}>
                {s && <SiirFotosu siir={s} duygu={d} sinif="serit-foto" sizes="(min-width: 72rem) 72rem, 100vw" genislikler={[600, 1000, 1500]} />}
                <span class="serit-ad">{d.ad}</span>
                <span class="serit-bilgi">
                  {sayilar[d.slug]} şiir
                  <br />
                  {d.renkAdi}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="yerler" aria-labelledby="yerler-baslik">
    <div class="bolum-bas">
      <h2 id="yerler-baslik">Yazıldıkları yerler</h2>
      <p>
        Moda'dan Burgazada'ya, bir Eminönü vapurundan Eyfel Kulesi'nin altına. <a href="/harita/">Haritada gör →</a>
      </p>
    </div>
    <ul class="yer-seridi">
      {
        yerListesi.map((y) => (
          <li>
            <a class="yer-karti" href={yerYolu(y.ad)}>
              <SiirFotosu siir={y.siirler[0]} sinif="yer-foto" sizes="12rem" genislikler={[320, 480]} />
              <span class="yer-ad">{y.ad}</span>
              <span class="yer-bilgi">
                {y.siirler.length} şiir{UZAK_YERLER[y.ad] ? ` · ${UZAK_YERLER[y.ad]}` : ''}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <p class="ya-da">
    ya da <a href="/fal/">niyet tut, bir şiir çek</a> · <a href="/siirler/">bütün şiirler</a>
  </p>
</Temel>

<script is:inline define:vars={{ takvim, ozel: OZEL_GUNLER }}>
  window.__takvim = takvim;
  window.__ozel = ozel;
</script>

<script>
  interface Gun {
    gun: string;
    yil: string;
    gunAy: string;
    ad: string;
    yer: string | null;
    yerde: string | null;
    href: string;
    renk: string;
  }
  const { __takvim: takvim, __ozel: ozel } = window as unknown as { __takvim: Gun[]; __ozel: Record<string, string> };
  const simdi = new Date();
  const bugun = `${String(simdi.getMonth() + 1).padStart(2, '0')}-${String(simdi.getDate()).padStart(2, '0')}`;
  const eslesen = takvim.filter((t) => t.gun === bugun);
  const kutu = document.getElementById('bugun');

  if (kutu && eslesen.length) {
    const baslik = document.createElement('p');
    baslik.className = 'etiket';
    baslik.textContent = `Bugün, ${eslesen[0].gunAy}`;
    const not = document.createElement('p');
    not.className = 'bugun-not';
    const ayniYer = eslesen.length > 1 && eslesen.every((t) => t.yer && t.yer === eslesen[0].yer);
    if (ayniYer) {
      const fark = Number(eslesen[eslesen.length - 1].yil) - Number(eslesen[0].yil);
      not.textContent = `Bu ${eslesen.length} şiir bugün, ${eslesen[0].yerde}, ${fark} yıl arayla yazıldı.`;
    } else if (eslesen.length > 1) {
      const onEk = ozel[bugun] ? `${ozel[bugun][0].toLocaleUpperCase('tr')}${ozel[bugun].slice(1)}. ` : '';
      not.textContent = `${onEk}Bu tarihte, farklı yıllarda yazılmış ${eslesen.length} şiir var.`;
    } else {
      not.textContent = `Bu şiir ${eslesen[0].yil} yılında bugün yazıldı.`;
    }
    const liste = document.createElement('ul');
    liste.className = 'cipler';
    for (const t of eslesen) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.className = 'cip';
      a.href = t.href;
      a.style.setProperty('--nokta', t.renk);
      const nokta = document.createElement('span');
      nokta.className = 'nokta';
      a.append(nokta, `${t.ad} · ${t.yil}`);
      li.append(a);
      liste.append(li);
    }
    kutu.append(baslik, not, liste);
    kutu.hidden = false;
  }
</script>

<style>
  /* ---------- Vitrin ---------- */
  .vitrin {
    min-height: min(100svh, 60rem);
    display: block;
  }
  .vitrin::after {
    display: none;
  }
  .vitrin-oge {
    display: none;
    position: relative;
    min-height: inherit;
  }
  .vitrin-oge[data-secili] {
    display: grid;
    align-items: end;
  }
  .vitrin-oge > :global(.foto) {
    position: absolute;
    inset: 0;
  }
  .vitrin-oge::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.35) 0%,
      transparent 20%,
      transparent 40%,
      color-mix(in srgb, var(--zemin) 82%, transparent) 74%,
      var(--zemin) 100%
    );
    pointer-events: none;
  }
  .vitrin-ic {
    padding-bottom: 3rem;
  }
  .vitrin-etiket {
    color: var(--vurgu);
  }
  .vitrin-misra {
    font-family: var(--serif-baslik);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(2.6rem, 1.6rem + 5vw, 5.6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0.9rem 0 1.1rem;
    max-width: 15ch;
    text-wrap: balance;
  }
  .vitrin-misra em {
    color: var(--vurgu);
  }
  .vitrin-imza {
    margin: 0;
    font-family: var(--etiket);
    font-size: 0.82rem;
    color: color-mix(in srgb, var(--yazi) 70%, transparent);
  }
  .vitrin-imza b {
    font-weight: 500;
    color: var(--yazi);
  }
  .vitrin-oku {
    margin-top: 0.4rem;
    color: var(--yazi);
  }

  /* ---------- Soru ---------- */
  .soru {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1rem var(--kenar) 0;
  }
  .soru h2 {
    margin-bottom: 1rem;
  }

  .bugun {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3rem var(--kenar) 0;
  }
  .bugun :global(.bugun-not) {
    margin: 0.4rem 0 1rem;
    font-family: var(--serif-baslik);
    font-style: italic;
    font-weight: 300;
    font-size: 1.5rem;
  }

  .bolum-bas {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
    max-width: 40rem;
  }
  .bolum-bas h2 {
    font-size: clamp(2.2rem, 1.6rem + 2.6vw, 3.6rem);
  }
  .bolum-bas p {
    margin: 0;
    color: var(--soluk);
  }

  /* ---------- Yedi duygu: fotoğraflı şeritler ---------- */
  .duygular,
  .yerler {
    max-width: 72rem;
    margin: 0 auto;
    padding: 6rem var(--kenar) 0;
  }
  .seritler {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .serit {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    height: clamp(6.5rem, 4rem + 9vw, 11rem);
    padding: 0 1.1rem 0.9rem;
    overflow: hidden;
    text-decoration: none;
  }
  .serit > :global(.foto) {
    position: absolute;
    inset: 0;
    z-index: 0;
    transition: transform 1.2s ease;
  }
  .serit::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.55), transparent 55%, rgba(0, 0, 0, 0.5));
  }
  .serit:hover > :global(.foto) {
    transform: scale(1.04);
  }
  .serit-ad {
    position: relative;
    z-index: 1;
    font-family: var(--serif-baslik);
    font-weight: 300;
    font-size: clamp(2.6rem, 1.8rem + 4vw, 5.4rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .serit-bilgi {
    position: relative;
    z-index: 1;
    font-family: var(--etiket);
    font-weight: 600;
    font-size: 0.64rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-align: right;
    line-height: 1.6;
    color: var(--vurgu);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
  }

  /* ---------- Yerler: yana kayan kartlar ---------- */
  .yer-seridi {
    list-style: none;
    margin: 0 calc(var(--kenar) * -1);
    padding: 0 var(--kenar) 1rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 11.5rem;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--kenar);
    scrollbar-width: thin;
  }
  .yer-seridi li {
    scroll-snap-align: start;
  }
  .yer-karti {
    display: grid;
    gap: 0.35rem;
    text-decoration: none;
  }
  .yer-karti :global(.yer-foto) {
    aspect-ratio: 3 / 4;
    border-radius: 2px;
  }
  .yer-ad {
    font-family: var(--serif-baslik);
    font-weight: 300;
    font-size: 1.4rem;
    line-height: 1.15;
    margin-top: 0.4rem;
  }
  .yer-bilgi {
    font-family: var(--etiket);
    font-size: 0.75rem;
    color: var(--soluk);
  }
  .yer-karti:hover .yer-ad {
    color: var(--vurgu);
  }

  .ya-da {
    max-width: 72rem;
    margin: 0 auto;
    padding: 4rem var(--kenar) 1rem;
    color: var(--soluk);
  }
  .ya-da a {
    color: var(--yazi);
  }
</style>
