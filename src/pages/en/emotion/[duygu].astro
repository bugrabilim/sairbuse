---
import Sayfa from '../../../sayfalar/Duygu.astro';
import { DUYGULAR } from '../../../data/duygular';
import { tumSiirler } from '../../../lib/siirler';
import { DUYGU_EN } from '../../../i18n';

export async function getStaticPaths() {
  const tum = await tumSiirler();
  return DUYGULAR.map((d) => ({
    params: { duygu: DUYGU_EN[d.slug] },
    props: {
      d,
      siirler: tum.filter((s) => s.data.duygular.includes(d.slug)),
      kaynak: tum.find((s) => s.id === d.kaynak),
    },
  }));
}
---

<Sayfa {...Astro.props} />
