---
import Temel from '../layouts/Temel.astro';
import SiirListesi from '../components/SiirListesi.astro';
import SayfaSahnesi from '../components/SayfaSahnesi.astro';
import harita from '../data/harita.json';
import haritaGenis from '../data/harita-genis.json';
import { DIS_YERLER, HARITA_YERLERI, ISTANBUL, UZAK_YERLER, yerSlug } from '../data/yerler';
import { anaDuygu, ad, tumSiirler, yerGrubu, yerYolu, type Siir } from '../lib/siirler';

const tum = await tumSiirler();
const yerdekiler = new Map<string, Siir[]>();
for (const s of tum) {
  const y = yerGrubu(s);
  if (y) yerdekiler.set(y, [...(yerdekiler.get(y) ?? []), s]);
}

// Haritaların Merkator izdüşümü (scripts/harita.py ile aynı)
const merkator = (lon: number, lat: number) => [
  (lon * 20037508.34) / 180,
  (Math.log(Math.tan(((90 + lat) * Math.PI) / 360)) * 20037508.34) / Math.PI,
];
function izdusum(h: { genislik: number; sinir: { bati: number; guney: number; dogu: number; kuzey: number } }) {
  const [x0] = merkator(h.sinir.bati, h.sinir.guney);
  const [x1, y1] = merkator(h.sinir.dogu, h.sinir.kuzey);
  const olcek = h.genislik / (x1 - x0);
  return (lon: number, lat: number) => {
    const [x, y] = merkator(lon, lat);
    return { x: (x - x0) * olcek, y: (y1 - y) * olcek };
  };
}
const izdus = izdusum(harita);
const izdusGenis = izdusum(haritaGenis);

const isaretler = Object.entries(HARITA_YERLERI)
  .filter(([ad]) => yerdekiler.has(ad))
  .map(([yerAdi, y]) => {
    const siirler = yerdekiler.get(yerAdi)!;
    return { yerAdi, ...y, ...izdus(y.boylam, y.enlem), siirler };
  });

const haritadakiler = isaretler.map((i) => i.yerAdi);
const istanbulSiirleri = isaretler.reduce((t, i) => t + i.siirler.length, 0);
const istanbulNoktasi = izdusGenis(ISTANBUL.boylam, ISTANBUL.enlem);
const disIsaretler = Object.entries(DIS_YERLER)
  .filter(([ad]) => yerdekiler.has(ad))
  .map(([yerAdi, y]) => ({ yerAdi, ...y, ...izdusGenis(y.boylam, y.enlem), siirler: yerdekiler.get(yerAdi)! }));
const denizler = [
  { ad: 'Karadeniz', yasla: 'end', ...izdusGenis(32.3, 43.4) },
  { ad: 'Ege', yasla: 'middle', ...izdusGenis(24.2, 37.6) },
  { ad: 'Akdeniz', yasla: 'middle', ...izdusGenis(15.5, 35.9) },
];
const uzaklar = [...yerdekiler.keys()].filter((y) => !haritadakiler.includes(y));
const ARA = 16; // aynı yerdeki noktalar arası
---

<Temel baslik="Harita" aciklama="Şiirlerin yazıldığı yerler: Moda, Kalkedon, Cihangir, Eminönü vapuru, adalar…" sahne>
  <SayfaSahnesi
    foto="sayfa-harita"
    etiket={`${haritadakiler.length} yer, ${isaretler.reduce((t, i) => t + i.siirler.length, 0)} şiir`}
    baslik="Harita"
  >
    Şiirlerin çoğu İstanbul'da, suya yakın yazılmış. Her nokta bir şiir, rengi o şiirin duygusu.
  </SayfaSahnesi>
  <section class="sayfa">

    <figure class="harita" id="istanbul-haritasi">
      <svg viewBox={`0 0 ${harita.genislik} ${harita.yukseklik}`} role="group" aria-label="İstanbul haritası">
        <g class="kara" aria-hidden="true">
          {harita.kara.map((d) => <path d={d} />)}
        </g>
        <text class="deniz-adi" x="250" y="560" aria-hidden="true">Marmara</text>
        <text class="deniz-adi bogaz" x="424" y="84" text-anchor="middle" aria-hidden="true" transform="rotate(-50 424 84)">Boğaz</text>
        {
          isaretler.map((i) => {
            const n = i.siirler.length;
            const bas = i.yon === 'sag' ? 0 : -(n - 1) * ARA;
            const etiketX = i.yon === 'sag' ? (n - 1) * ARA + 15 : -(n - 1) * ARA - 15;
            return (
              <a href={`#${yerSlug(i.yerAdi)}`} class="isaret">
                <g transform={`translate(${i.x.toFixed(1)} ${i.y.toFixed(1)})`}>
                <title>{`${i.yerAdi}: ${i.siirler.map(ad).join(' · ')}`}</title>
                <circle class="hale" r={14 + (n - 1) * ARA * 0.6} cx={bas + ((n - 1) * ARA) / 2} />
                {i.siirler.map((s, k) => (
                  <circle class={anaDuygu(s).hepGece ? 'nokta-svg siyah' : 'nokta-svg'} cx={bas + k * ARA} r="7" fill={anaDuygu(s).nokta} />
                ))}
                <text x={etiketX} y={i.etiketY ?? 8} text-anchor={i.yon === 'sag' ? 'start' : 'end'}>
                  {i.etiket ?? i.yerAdi}
                </text>
                </g>
              </a>
            );
          })
        }
      </svg>
      <figcaption>Kıyı şeridi: {harita.kaynak}</figcaption>
    </figure>

    {
      isaretler.map((i) => (
        <section class="yer" id={yerSlug(i.yerAdi)} aria-labelledby={`b-${yerSlug(i.yerAdi)}`}>
          <h2 id={`b-${yerSlug(i.yerAdi)}`} class="yer-adi">
            <a href={yerYolu(i.yerAdi)}>{i.yerAdi} →</a>
          </h2>
          <SiirListesi siirler={i.siirler} />
        </section>
      ))
    }

    {
      uzaklar.length > 0 && (
        <section class="yer uzak" aria-labelledby="uzak-baslik">
          <h2 id="uzak-baslik" class="ust-etiket">
            İstanbul'un dışında
          </h2>
          <figure class="harita genis">
            <svg viewBox={`0 0 ${haritaGenis.genislik} ${haritaGenis.yukseklik}`} role="group" aria-label="İstanbul'un dışındaki yerler: Paris'ten Marmaris'e">
              <g class="kara" aria-hidden="true">
                {haritaGenis.kara.map((d) => <path d={d} />)}
              </g>
              {denizler.map((d) => (
                <text class="deniz-adi kucuk" x={d.x.toFixed(1)} y={d.y.toFixed(1)} text-anchor={d.yasla} aria-hidden="true">
                  {d.ad}
                </text>
              ))}
              <a href="#istanbul-haritasi" class="isaret istanbul">
                <g transform={`translate(${istanbulNoktasi.x.toFixed(1)} ${istanbulNoktasi.y.toFixed(1)})`}>
                  <title>{`İstanbul: ${istanbulSiirleri} şiir (yukarıdaki haritada)`}</title>
                  <circle class="hale" r="16" />
                  <circle class="nokta-svg istanbul-nokta" r="8" />
                  <text x="-22" y="8" text-anchor="end">
                    İstanbul · {istanbulSiirleri} şiir
                  </text>
                </g>
              </a>
              {disIsaretler.map((i) => {
                const n = i.siirler.length;
                const bas = i.yon === 'sag' ? 0 : -(n - 1) * ARA;
                const etiketX = i.yon === 'sag' ? (n - 1) * ARA + 15 : -(n - 1) * ARA - 15;
                return (
                  <a href={yerYolu(i.yerAdi)} class="isaret">
                    <g transform={`translate(${i.x.toFixed(1)} ${i.y.toFixed(1)})`}>
                      <title>{`${i.yerAdi}: ${i.siirler.map(ad).join(' · ')}`}</title>
                      <circle class="hale" r={14 + (n - 1) * ARA * 0.6} cx={bas + ((n - 1) * ARA) / 2} />
                      {i.siirler.map((s, k) => (
                        <circle class={anaDuygu(s).hepGece ? 'nokta-svg siyah' : 'nokta-svg'} cx={bas + k * ARA} r="7" fill={anaDuygu(s).nokta} />
                      ))}
                      <text x={etiketX} y={i.etiketY ?? 8} text-anchor={i.yon === 'sag' ? 'start' : 'end'}>
                        {i.etiket ?? i.yerAdi}
                      </text>
                    </g>
                  </a>
                );
              })}
            </svg>
            <figcaption>Kıyı şeridi: {haritaGenis.kaynak}</figcaption>
          </figure>
          {uzaklar
            .filter((y) => y in DIS_YERLER)
            .map((y) => (
              <section class="uzak-yer" id={yerSlug(y)}>
                <h3 class="yer-adi kucuk">
                  <a href={yerYolu(y)}>{y} →</a>
                  {UZAK_YERLER[y] && <span class="uzak-not"> · {UZAK_YERLER[y]}</span>}
                </h3>
                <SiirListesi siirler={yerdekiler.get(y)!} />
              </section>
            ))}
        </section>
      )
    }

    {
      uzaklar.some((y) => !(y in DIS_YERLER)) && (
        <section class="yer uzak" aria-labelledby="yersiz-baslik">
          <h2 id="yersiz-baslik" class="ust-etiket">
            Haritada yeri olmayanlar
          </h2>
          {uzaklar
            .filter((y) => !(y in DIS_YERLER))
            .map((y) => (
              <section class="uzak-yer" id={yerSlug(y)}>
                <h3 class="yer-adi kucuk">{y}</h3>
                <SiirListesi siirler={yerdekiler.get(y)!} />
              </section>
            ))}
        </section>
      )
    }
  </section>
</Temel>

<style>
  .harita {
    margin: 2rem auto 1rem;
    max-width: 40rem;
  }
  .harita svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .kara path {
    fill: color-mix(in srgb, var(--yazi) 7%, var(--zemin));
    stroke: color-mix(in srgb, var(--soluk) 60%, transparent);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }
  .deniz-adi {
    font-family: var(--serif-baslik);
    font-style: italic;
    font-size: 30px;
    letter-spacing: 0.3em;
    fill: color-mix(in srgb, var(--soluk) 55%, transparent);
  }
  .isaret text {
    font-family: var(--serif-baslik);
    font-style: italic;
    font-weight: 300;
    font-size: 25px;
    fill: var(--yazi);
    paint-order: stroke;
    stroke: var(--zemin);
    stroke-width: 5px;
    stroke-linejoin: round;
  }
  .bogaz {
    font-size: 22px;
    letter-spacing: 0.25em;
  }
  .deniz-adi.kucuk {
    font-size: 20px;
    letter-spacing: 0.3em;
  }
  .istanbul-nokta {
    fill: var(--yazi);
  }
  .harita.genis {
    margin: 1rem auto 2.5rem;
  }
  @media (max-width: 40rem) {
    .isaret text {
      font-size: 31px;
    }
    .deniz-adi {
      font-size: 34px;
    }
    .bogaz {
      font-size: 26px;
    }
  }
  .nokta-svg {
    stroke: var(--zemin);
    stroke-width: 2;
  }
  .nokta-svg.siyah {
    stroke: var(--soluk);
    stroke-width: 1.5;
  }
  .hale {
    fill: transparent;
  }
  .isaret:hover .hale,
  .isaret:focus-visible .hale {
    fill: color-mix(in srgb, var(--yazi) 12%, transparent);
  }
  .isaret:hover text,
  .isaret:focus-visible text {
    text-decoration: underline;
  }
  .harita figcaption {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    color: var(--soluk);
    text-align: right;
  }
  .yer {
    margin-top: 2.75rem;
    scroll-margin-top: 1rem;
  }
  .yer-adi {
    font-size: 1.9rem;
    font-style: italic;
    margin-bottom: 0.4rem;
  }
  .yer-adi a {
    text-decoration: none;
  }
  .yer-adi a:hover {
    color: var(--vurgu);
  }
  .yer-adi.kucuk {
    font-size: 1.5rem;
  }
  .uzak-yer {
    margin-top: 1.5rem;
    scroll-margin-top: 1rem;
  }
  .uzak-not {
    color: var(--soluk);
    font-size: 1.05rem;
  }
  .yer:target .yer-adi,
  .uzak-yer:target .yer-adi {
    color: var(--vurgu);
  }
</style>
