---
import '@fontsource/fraunces/latin-300.css';
import '@fontsource/fraunces/latin-ext-300.css';
import '@fontsource/fraunces/latin-300-italic.css';
import '@fontsource/fraunces/latin-ext-300-italic.css';
import '@fontsource/fraunces/latin-400.css';
import '@fontsource/fraunces/latin-ext-400.css';
import '@fontsource/fraunces/latin-400-italic.css';
import '@fontsource/fraunces/latin-ext-400-italic.css';
import '@fontsource/newsreader/latin-400.css';
import '@fontsource/newsreader/latin-ext-400.css';
import '@fontsource/newsreader/latin-400-italic.css';
import '@fontsource/newsreader/latin-ext-400-italic.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-ext-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-ext-600.css';
import '../styles/global.css';
import AltBilgi from '../components/AltBilgi.astro';
import { SITE } from '../data/site';
import { DUYGULAR, duyguAdi, duyguStili, type Duygu } from '../data/duygular';
import { DILLER, OG_YEREL, dilBul, duyguYolu, karsilik, kucuk, metin, sayfaYolu } from '../i18n';

interface Props {
  baslik?: string;
  aciklama?: string;
  gorsel?: string;
  duygu?: Duygu;
  sinif?: string;
  /** Sayfa ekranı kaplayan bir fotoğrafla açılıyorsa üst şerit fotoğrafın üstünde durur */
  sahne?: boolean;
  /** Arama motorları dizine almasın (404, 500) */
  noindex?: boolean;
  /** Sayfanın öbür dilde karşılığı yoksa (404, 500) dil değiştirici ana sayfaya gider */
  karsilikYok?: boolean;
}

const yol = Astro.url.pathname;
const dil = dilBul(Astro.url);
const m = metin(dil);
const obur = dil === 'tr' ? 'en' : 'tr';
const {
  baslik,
  aciklama = m.site.aciklama,
  gorsel = dil === 'en' ? '/og/en/site.jpg' : '/og/site.jpg',
  duygu,
  sinif = '',
  sahne = false,
  noindex = false,
  karsilikYok = false,
} = Astro.props;
const tamBaslik = baslik ? `${baslik} — ${SITE.ad}` : SITE.ad;
const kanonik = new URL(yol, Astro.site);
const gorselUrl = new URL(gorsel, Astro.site);
const umami = import.meta.env.PUBLIC_UMAMI_ID || SITE.umami;
// Her dilde aynı sayfanın adresi (hreflang ve dil değiştirici)
const diller = DILLER.map((d) => ({ dil: d, href: karsilikYok ? sayfaYolu('ana', d) : karsilik(yol, d) }));
const oburYol = diller.find((x) => x.dil === obur)!.href;
const menu = (['siirler', 'harita', 'zaman', 'fal', 'hakkinda'] as const).map((s) => ({ href: sayfaYolu(s, dil), ad: m.menu[s] }));
const govdeSinifi = [duygu ? 'duygulu' : '', sahne ? 'sahneli' : '', sinif].filter(Boolean).join(' ');
const temaRengi = duygu ? duygu.zeminGece : '#0d0c0b';
const temaRengiGunduz = duygu ? duygu.zeminGunduz : '#f3eee5';
---

<!doctype html>
<html lang={dil} data-theme="gece">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tamBaslik}</title>
    <meta name="description" content={aciklama} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={kanonik} />
    {
      !noindex && (
        <>
          {diller.map((d) => <link rel="alternate" hreflang={d.dil} href={new URL(d.href, Astro.site)} />)}
          <link rel="alternate" hreflang="x-default" href={new URL(diller[0].href, Astro.site)} />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content={temaRengi} data-gece={temaRengi} data-gunduz={temaRengiGunduz} />
    <meta name="author" content={SITE.sair} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={OG_YEREL[dil]} />
    <meta property="og:locale:alternate" content={OG_YEREL[obur]} />
    <meta property="og:site_name" content={SITE.ad} />
    <meta property="og:title" content={tamBaslik} />
    <meta property="og:description" content={aciklama} />
    <meta property="og:url" content={kanonik} />
    <meta property="og:image" content={gorselUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="bas" />

    <script is:inline>
      // Tema sayfa çizilmeden seçilir ki yanlış tema bir an bile görünmesin.
      // Varsayılan gece (koyu); okur düğmeyle gündüzü seçerse localStorage'da hatırlanır ("tema").
      (function () {
        var k = document.documentElement;
        var t = null;
        try {
          t = localStorage.getItem('tema');
        } catch (e) {}
        if (t !== 'gece' && t !== 'gunduz') t = 'gece';
        k.setAttribute('data-theme', t);
        k.classList.add('js');
      })();
      // Umami olayı; sayaç yüklenmediyse sessizce geçer. Olay verisine kişisel bilgi konmaz.
      window.bumbaOlay = function (ad, veri) {
        try {
          if (window.umami) window.umami.track(ad, veri);
        } catch (e) {}
      };
    </script>
    <script is:inline define:vars={{ dil, oburYol }}>
      // Dil seçimi hatırlanır: başka dili seçmiş biri siteye dışarıdan gelirse kendi diline geçer
      (function () {
        var secili = null;
        try {
          secili = localStorage.getItem('dil');
        } catch (e) {}
        var icerden = document.referrer && new URL(document.referrer).host === location.host;
        if (secili && secili !== dil && !icerden) location.replace(oburYol + location.search + location.hash);
      })();
    </script>
    <script defer src="https://istatistik.bumba.tr/script.js" data-website-id={umami} data-domains={SITE.alan}></script>
  </head>
  <body class={govdeSinifi} style={duygu ? duyguStili(duygu) : undefined} data-duygu={duygu?.slug}>
    <a class="atla" href="#icerik">{m.ust.icerigeGec}</a>
    <header class="ust">
      <a class="logo" href={sayfaYolu('ana', dil)}>{SITE.ad}</a>
      <div class="ust-araclar">
        <a class="ust-arac" href={sayfaYolu('arama', dil)} aria-label={m.ust.ara} aria-current={yol === sayfaYolu('arama', dil) ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6" /><path d="M15 15l5.5 5.5" /></svg>
        </a>
        <a class="ust-arac dil-dugmesi" href={oburYol} hreflang={obur} lang={obur} data-dil={obur} aria-label={m.dil.degistir}>{m.dil.oburKisa}</a>
        <button class="tema-dugmesi" type="button" aria-label={m.ust.gunduzeGec} data-gece={m.ust.gunduzeGec} data-gunduz={m.ust.geceyeGec}>
          <svg class="ikon-gunes" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" /></svg>
          <svg class="ikon-ay" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
        </button>
      </div>
      <button class="menu-dugmesi" type="button" aria-expanded="false" aria-controls="menu">
        <span class="gorunmez">{m.ust.menu}</span>
        <span class="cubuk" aria-hidden="true"></span>
      </button>
      <nav class="menu" id="menu" aria-label={m.ust.anaMenu}>
        <ul class="menu-yollar">
          {
            menu.map((x) => (
              <li>
                <a href={x.href} aria-current={yol.startsWith(x.href) ? 'page' : undefined}>
                  {x.ad}
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="menu-duygular" aria-label={m.ust.duygular}>
          {
            DUYGULAR.map((d) => (
              <li>
                <a href={duyguYolu(d.slug, dil)} style={`--nokta:${d.nokta}`}>
                  <span class="nokta" aria-hidden="true" />
                  {kucuk(duyguAdi(d, dil), dil)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="icerik">
      <slot />
    </main>

    <AltBilgi menu={menu} />

    <script>
      const dugme = document.querySelector<HTMLButtonElement>('.menu-dugmesi');
      const kok = document.documentElement;
      function kapat() {
        kok.classList.remove('menu-acik');
        dugme?.setAttribute('aria-expanded', 'false');
      }
      dugme?.addEventListener('click', () => {
        const acik = kok.classList.toggle('menu-acik');
        dugme.setAttribute('aria-expanded', String(acik));
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && kok.classList.contains('menu-acik')) {
          kapat();
          dugme?.focus();
        }
      });
      document.querySelectorAll('.menu a').forEach((a) => a.addEventListener('click', kapat));

      // Tema düğmesi: seçimi hatırlar
      const temaDugmesi = document.querySelector<HTMLButtonElement>('.tema-dugmesi');
      const temaMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      function temaUygula(t: string) {
        kok.setAttribute('data-theme', t);
        if (temaDugmesi) temaDugmesi.setAttribute('aria-label', temaDugmesi.dataset[t] ?? '');
        if (temaMeta) temaMeta.content = temaMeta.dataset[t] ?? temaMeta.content;
      }
      temaUygula(kok.getAttribute('data-theme') ?? 'gece');
      temaDugmesi?.addEventListener('click', () => {
        const yeni = kok.getAttribute('data-theme') === 'gunduz' ? 'gece' : 'gunduz';
        temaUygula(yeni);
        try {
          localStorage.setItem('tema', yeni);
        } catch {}
        window.bumbaOlay?.('tema-degistir', { tema: yeni });
      });

      // Dil değiştirici: seçimi hatırlar
      document.querySelector<HTMLAnchorElement>('.dil-dugmesi')?.addEventListener('click', (e) => {
        const hedef = (e.currentTarget as HTMLAnchorElement).dataset.dil ?? 'tr';
        try {
          localStorage.setItem('dil', hedef);
        } catch {}
        window.bumbaOlay?.('dil-degistir', { dil: hedef });
      });
    </script>
  </body>
</html>
