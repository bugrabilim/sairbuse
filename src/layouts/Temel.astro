---
import '@fontsource/fraunces/latin-300.css';
import '@fontsource/fraunces/latin-ext-300.css';
import '@fontsource/fraunces/latin-300-italic.css';
import '@fontsource/fraunces/latin-ext-300-italic.css';
import '@fontsource/fraunces/latin-400.css';
import '@fontsource/fraunces/latin-ext-400.css';
import '@fontsource/fraunces/latin-400-italic.css';
import '@fontsource/fraunces/latin-ext-400-italic.css';
import '@fontsource/newsreader/latin-400.css';
import '@fontsource/newsreader/latin-ext-400.css';
import '@fontsource/newsreader/latin-400-italic.css';
import '@fontsource/newsreader/latin-ext-400-italic.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-ext-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-ext-600.css';
import '../styles/global.css';
import AltBilgi from '../components/AltBilgi.astro';
import { SITE } from '../data/site';
import { DUYGULAR, duyguStili, type Duygu } from '../data/duygular';

interface Props {
  baslik?: string;
  aciklama?: string;
  gorsel?: string;
  duygu?: Duygu;
  sinif?: string;
  /** Sayfa ekranı kaplayan bir fotoğrafla açılıyorsa üst şerit fotoğrafın üstünde durur */
  sahne?: boolean;
}

const { baslik, aciklama = SITE.aciklama, gorsel = '/og/site.jpg', duygu, sinif = '', sahne = false } = Astro.props;
const tamBaslik = baslik ? `${baslik} — ${SITE.ad}` : SITE.ad;
const kanonik = new URL(Astro.url.pathname, Astro.site);
const gorselUrl = new URL(gorsel, Astro.site);
const umami = import.meta.env.PUBLIC_UMAMI_ID;
const yol = Astro.url.pathname;
const menu = [
  { href: '/siirler/', ad: 'şiirler' },
  { href: '/harita/', ad: 'harita' },
  { href: '/zaman/', ad: 'zaman' },
  { href: '/fal/', ad: 'fal' },
  { href: '/hakkinda/', ad: 'hakkında' },
];
const govdeSinifi = [duygu ? 'duygulu' : '', sahne ? 'sahneli' : '', sinif].filter(Boolean).join(' ');
const temaRengi = duygu ? duygu.zeminGece : '#0d0c0b';
---

<!doctype html>
<html lang="tr" data-theme="gece">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tamBaslik}</title>
    <meta name="description" content={aciklama} />
    <link rel="canonical" href={kanonik} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content={temaRengi} />
    <meta name="author" content={SITE.sair} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={SITE.ad} />
    <meta property="og:title" content={tamBaslik} />
    <meta property="og:description" content={aciklama} />
    <meta property="og:url" content={kanonik} />
    <meta property="og:image" content={gorselUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {umami && <script defer src="https://istatistik.bumba.tr/script.js" data-website-id={umami} />}
  </head>
  <body class={govdeSinifi} style={duygu ? duyguStili(duygu) : undefined} data-duygu={duygu?.slug}>
    <a class="atla" href="#icerik">İçeriğe geç</a>
    <header class="ust">
      <a class="logo" href="/">{SITE.ad}</a>
      <button class="menu-dugmesi" type="button" aria-expanded="false" aria-controls="menu">
        <span class="gorunmez">Menü</span>
        <span class="cubuk" aria-hidden="true"></span>
      </button>
      <nav class="menu" id="menu" aria-label="Ana menü">
        <ul class="menu-yollar">
          {
            menu.map((m) => (
              <li>
                <a href={m.href} aria-current={yol.startsWith(m.href) ? 'page' : undefined}>
                  {m.ad}
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="menu-duygular" aria-label="Duygular">
          {
            DUYGULAR.map((d) => (
              <li>
                <a href={`/duygu/${d.slug}/`} style={`--nokta:${d.nokta}`}>
                  <span class="nokta" aria-hidden="true" />
                  {d.ad.toLocaleLowerCase('tr')}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="icerik">
      <slot />
    </main>

    <AltBilgi menu={menu} />

    <script>
      const dugme = document.querySelector<HTMLButtonElement>('.menu-dugmesi');
      const kok = document.documentElement;
      function kapat() {
        kok.classList.remove('menu-acik');
        dugme?.setAttribute('aria-expanded', 'false');
      }
      dugme?.addEventListener('click', () => {
        const acik = kok.classList.toggle('menu-acik');
        dugme.setAttribute('aria-expanded', String(acik));
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && kok.classList.contains('menu-acik')) {
          kapat();
          dugme?.focus();
        }
      });
      document.querySelectorAll('.menu a').forEach((a) => a.addEventListener('click', kapat));
    </script>
  </body>
</html>
